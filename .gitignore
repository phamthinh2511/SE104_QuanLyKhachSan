# ==========================================
# Visual Studio & .NET Core / WPF
# ==========================================

# Thư mục chứa file cấu hình cá nhân của Visual Studio
.vs/

# Thư mục chứa kết quả build (Cực kỳ quan trọng phải bỏ qua)
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Các file cấu hình cá nhân của user
*.user
*.suo
*.userosscache
*.sln.docstates

# ==========================================
# NuGet Packages
# ==========================================
*.nupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# ==========================================
# ASP.NET Core (Backend)
# ==========================================
# Bỏ qua các file cấu hình môi trường chứa chuỗi kết nối Database nhạy cảm ở máy local
appsettings.Development.json
appsettings.Staging.json

# Bỏ qua thư mục build publish
**/[Pp]ublish/
**/[Oo]ut/

# ==========================================
# Các file rác/tạm thời khác
# ==========================================
*.log
*.cache
*.tmp
*.bak
Thumbs.db
