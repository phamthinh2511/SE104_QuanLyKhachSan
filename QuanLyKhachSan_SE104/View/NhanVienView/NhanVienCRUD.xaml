<Window x:Class="QuanLyKhachSan_SE104.View.NhanVienView.NhanVienCRUD"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vmns="clr-namespace:QuanLyKhachSan_SE104.ViewModel.NhanVien"
        Title="Nhân sự"
        Height="420" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <Style x:Key="FormActionButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="10"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="FormField" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="20" Background="White" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.18"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" CornerRadius="20,20,0,0" Background="#1E293B">
                <Grid Margin="24,0">
                    <TextBlock Text="Thông Tin Nhân Sự"
                               FontSize="18" FontWeight="Bold" Foreground="White"
                               VerticalAlignment="Center"/>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="32" Height="32"
                            Command="{Binding CancelCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                            Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" CornerRadius="16" Background="Transparent">
                                    <TextBlock Text="✕" FontSize="14" FontWeight="Bold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#FFFFFF22"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- BODY -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
                <ContentControl Content="{Binding}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Style.Triggers>

                                <!-- NHÂN VIÊN -->
                                <DataTrigger Binding="{Binding Mode}"
                                 Value="{x:Static vmns:ModeNhanSu.NhanVien}">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <StackPanel>

                                                    <TextBlock Style="{StaticResource FormLabel}" Text="Họ tên *"/>
                                                    <TextBox Style="{StaticResource FormField}"
                                                 Text="{Binding NhanVien.HoTen, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,0,16"/>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="12"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Style="{StaticResource FormLabel}" Text="Chức vụ (Quản lý?)"/>
                                                            <!-- nên đổi sang CheckBox -->
                                                            <CheckBox IsChecked="{Binding NhanVien.ChucVu}" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Style="{StaticResource FormLabel}" Text="Trạng thái làm việc"/>
                                                            <CheckBox IsChecked="{Binding NhanVien.TrangThaiLamViec}" />
                                                        </StackPanel>

                                                    </Grid>

                                                </StackPanel>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>

                                <!-- TÀI KHOẢN -->
                                <DataTrigger Binding="{Binding Mode}"
                                 Value="{x:Static vmns:ModeNhanSu.TaiKhoan}">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <StackPanel>

                                                    <TextBlock Style="{StaticResource FormLabel}" Text="Username *"/>
                                                    <TextBox Style="{StaticResource FormField}"
                                                 Text="{Binding TaiKhoan.Username, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,0,16"/>

                                                    <TextBlock Style="{StaticResource FormLabel}" Text="Password *"/>
                                                    <TextBox Style="{StaticResource FormField}"
                                                 Text="{Binding TaiKhoan.PasswordHash, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,0,16"/>

                                                    <TextBlock Style="{StaticResource FormLabel}" Text="Nhân viên"/>
                                                    <ComboBox Style="{StaticResource ModernComboBox}"
                                                              ItemsSource="{Binding DanhSachNhanVien}"
                                                              SelectedValue="{Binding TaiKhoan.MaNhanVien, UpdateSourceTrigger=PropertyChanged}"
                                                              SelectedValuePath="MaNhanVien"
                                                              DisplayMemberPath="HoTen"
                                                              Margin="0,0,0,16"/>

                                                </StackPanel>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>

                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </ScrollViewer>
            <!-- FOOTER -->
            <Border Grid.Row="2" CornerRadius="0,0,20,20"
                    Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Style="{StaticResource FormActionButton}"
                            Background="#1E293B" Foreground="White"
                            Content="Lưu"
                            Command="{Binding SaveCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                            Margin="0,0,12,0"/>
                    <Button Style="{StaticResource FormActionButton}"
                            Background="#F1F5F9" Foreground="#64748B"
                            Content="Hủy"
                            Command="{Binding CancelCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</Window>