<UserControl x:Class="QuanLyKhachSan_SE104.View.TraPhongPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FDF5E6">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1.2*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#FFFDF0" CornerRadius="15" Padding="20" BorderBrush="#D2B48C" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Opacity="0.1" ShadowDepth="2" Color="#A52A2A"/>
            </Border.Effect>

            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="CHI TIẾT THANH TOÁN" 
                           FontSize="20" FontWeight="Bold" Foreground="#8B4513" Margin="0,0,0,20"/>

                <DataGrid ItemsSource="{Binding ListDichVuSuDung}" 
                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          Background="Transparent" BorderThickness="0" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#DEB887" RowHeight="50">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Foreground" Value="#5D4037"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="Background" Value="#E6D5B8"/>
                            <Setter Property="BorderThickness" Value="0,0,0,2"/>
                            <Setter Property="BorderBrush" Value="#D2B48C"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mô tả chi phí" Binding="{Binding DichVu.TenDichVu}" Width="*"/>
                        <DataGridTextColumn Header="SL / Ngày" Binding="{Binding SoLuong}" Width="80"/>
                        <DataGridTextColumn Header="Đơn Giá" Binding="{Binding DonGia, StringFormat={}{0:N0}}" Width="100"/>
                        <DataGridTextColumn Header="Thành Tiền" Binding="{Binding ThanhTien, StringFormat={}{0:N0}}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Background="#FFFDF0" CornerRadius="15" Padding="25" Margin="20,0,0,0" BorderBrush="#D2B48C" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="THÔNG TIN CHECK-OUT" FontSize="18" FontWeight="Bold" Foreground="#8B4513" Margin="0,0,0,20"/>

                <TextBlock Text="Khách hàng:" Foreground="#5D4037" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding ListKhachHang}" DisplayMemberPath="HoTen" SelectedItem="{Binding SelectedKhachHang}" Height="40" Margin="0,0,0,15"/>

                <TextBlock Text="Thời gian Check-out:" Foreground="#5D4037" Margin="0,0,0,5"/>
                <TextBox Text="{Binding CurrentTime, Mode=OneWay}" IsReadOnly="True" Height="40" Margin="0,0,0,15" VerticalContentAlignment="Center" Padding="10,0" Background="#F9F9F9"/>

                <TextBlock Text="Phương thức thanh toán:" Foreground="#5D4037" Margin="0,0,0,5"/>
                <ComboBox SelectedIndex="0" Height="40" Margin="0,0,0,20">
                    <ComboBoxItem Content="Tiền mặt"/>
                    <ComboBoxItem Content="Chuyển khoản"/>
                    <ComboBoxItem Content="Thẻ tín dụng"/>
                </ComboBox>

                <Separator Background="#DEB887" Margin="0,0,0,20"/>

                <TextBlock Text="Tổng hóa đơn:" Foreground="#5D4037" FontSize="14"/>
                <TextBlock Text="{Binding TongTienThanhToan, StringFormat={}{0:N0} VNĐ}" Foreground="#A52A2A" FontSize="26" FontWeight="Bold" Margin="0,5,0,30"/>

                <Button Command="{Binding ConfirmCheckoutCommand}" Height="60" Background="#C4A484" Cursor="Hand" BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                            <TextBlock Text="HOÀN TẤT THANH TOÁN" 
                                                       FontSize="12" 
                                                       FontWeight="Bold" 
                                                       Foreground="Black" 
                                                       HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
    