<UserControl x:Class="QuanLyKhachSan_SE104.View.TraPhongPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FDF5E6">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid>
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1.2*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#FFFDF0" CornerRadius="15" Padding="20" BorderBrush="#D2B48C" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Opacity="0.1" ShadowDepth="2" Color="#A52A2A"/>
            </Border.Effect>

            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="CHI TIẾT THANH TOÁN" 
                           FontSize="20" FontWeight="Bold" Foreground="#8B4513" Margin="0,0,0,20"/>

                <DataGrid ItemsSource="{Binding ListDichVuSuDung}" 
                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          Background="Transparent" BorderThickness="0" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#DEB887" RowHeight="50">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Foreground" Value="#5D4037"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="Background" Value="#E6D5B8"/>
                            <Setter Property="BorderThickness" Value="0,0,0,2"/>
                            <Setter Property="BorderBrush" Value="#D2B48C"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mô tả chi phí" Binding="{Binding DichVu.TenDichVu}" Width="*"/>
                        <DataGridTextColumn Header="SL / Ngày" Binding="{Binding SoLuong}" Width="80"/>
                        <DataGridTextColumn Header="Đơn Giá" Binding="{Binding DonGia, StringFormat={}{0:N0}}" Width="100"/>
                        <DataGridTextColumn Header="Thành Tiền" Binding="{Binding ThanhTien, StringFormat={}{0:N0}}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Background="#FFFDF0" CornerRadius="15" Padding="25" Margin="20,0,0,0" BorderBrush="#D2B48C" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="THÔNG TIN CHECK-OUT" FontSize="18" FontWeight="Bold" Foreground="#8B4513" Margin="0,0,0,20"/>

                <TextBlock Text="Khách hàng:" Foreground="#5D4037" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding ListKhachHang}" DisplayMemberPath="HoTen" SelectedItem="{Binding SelectedKhachHang}" Height="40" Margin="0,0,0,15"/>

                <TextBlock Text="Thời gian Check-out:" Foreground="#5D4037" Margin="0,0,0,5"/>
                <TextBox Text="{Binding CurrentTime, Mode=OneWay}" IsReadOnly="True" Height="40" Margin="0,0,0,15" VerticalContentAlignment="Center" Padding="10,0" Background="#F9F9F9"/>

                <TextBlock Text="Phương thức thanh toán:" Foreground="#5D4037" Margin="0,0,0,5"/>
                <ComboBox SelectedIndex="0" Height="40" Margin="0,0,0,20">
                    <ComboBoxItem Content="Tiền mặt"/>
                    <ComboBoxItem Content="Chuyển khoản"/>
                    <ComboBoxItem Content="Thẻ tín dụng"/>
                </ComboBox>

                <Separator Background="#DEB887" Margin="0,0,0,20"/>

                <TextBlock Text="Tổng hóa đơn:" Foreground="#5D4037" FontSize="14"/>
                <TextBlock Text="{Binding TongTienThanhToan, StringFormat={}{0:N0} VNĐ}" Foreground="#A52A2A" FontSize="26" FontWeight="Bold" Margin="0,5,0,30"/>

                <Button Command="{Binding ConfirmCheckoutCommand}" Height="60" Background="#C4A484" Cursor="Hand" BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                            <TextBlock Text="HOÀN TẤT THANH TOÁN" 
                                                       FontSize="12" 
                                                       FontWeight="Bold" 
                                                       Foreground="Black" 
                                                       HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>

    <!-- ══════════════════════════════════════════════ -->
    <!-- POPUP: HÓA ĐƠN                                -->
    <!-- ══════════════════════════════════════════════ -->
    <Grid Visibility="{Binding IsHoaDonOpen, Converter={StaticResource BoolToVis}}"
          Background="#80000000">
        <Grid.InputBindings>
            <MouseBinding MouseAction="LeftClick" Command="{Binding CloseHoaDonCommand}"/>
        </Grid.InputBindings>

        <Border Background="White" CornerRadius="16" Padding="0"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                Width="460">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.3"/>
            </Border.Effect>

            <StackPanel>
                <!-- Header: Logo + Hóa Đơn + X -->
                <Border Padding="25,22,25,18">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="44" Height="44" Background="#1A73E8" CornerRadius="10">
                            <TextBlock Text="🏨" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Button DockPanel.Dock="Right" Content="✕" FontSize="16"
                                Width="28" Height="28" VerticalAlignment="Center" Cursor="Hand"
                                Command="{Binding CloseHoaDonCommand}"
                                Background="Transparent" BorderThickness="0" Foreground="#94A3B8"/>
                        <TextBlock Text="Hóa Đơn" FontSize="22" FontWeight="Bold" Foreground="#1E293B"
                                   VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </DockPanel>
                </Border>

                <!-- Tên khách -->
                <StackPanel Margin="25,0,25,0">
                    <TextBlock Text="{Binding HoaDonTenKhach}"
                               FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Phòng " FontSize="12" Foreground="#64748B"/>
                        <TextBlock Text="{Binding HoaDonSoPhong}" FontSize="12" FontWeight="SemiBold" Foreground="#1A73E8"/>
                        <TextBlock Text="  •  " FontSize="12" Foreground="#CBD5E1"/>
                        <TextBlock Text="{Binding HoaDonThoiGian}" FontSize="12" Foreground="#64748B"/>
                    </StackPanel>
                </StackPanel>

                <!-- Đường kẻ -->
                <Border Background="#E2E8F0" Height="1" Margin="25,18,25,15"/>

                <!-- Chi tiết tiền -->
                <Grid Margin="25,0,25,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🛏️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Tiền phòng" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding HoaDonTienPhong, StringFormat='{}{0:#,0} VND'}"
                               FontSize="14" FontWeight="SemiBold" Foreground="#1E293B"/>
                </Grid>

                <Grid Margin="25,0,25,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="☕" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Tiền dịch vụ" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding HoaDonTienDichVu, StringFormat='{}{0:#,0} VND'}"
                               FontSize="14" FontWeight="SemiBold" Foreground="#1E293B"/>
                </Grid>

                <!-- Tổng cộng nổi bật -->
                <Border Background="#ECFDF5" CornerRadius="12" Margin="25,5,25,0" Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="TỔNG CỘNG" FontSize="11" FontWeight="Bold" Foreground="#059669" Opacity="0.8"/>
                            <TextBlock Text="Cần thanh toán" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding HoaDonTongTien, StringFormat='{}{0:#,0} VND'}"
                                   FontSize="22" FontWeight="Bold" Foreground="#059669"/>
                    </Grid>
                </Border>

                <TextBlock Text="✨ Cảm ơn quý khách! ✨" FontSize="12" Foreground="#94A3B8"
                           HorizontalAlignment="Center" Margin="0,18,0,0" FontStyle="Italic"/>

                <!-- Footer: Nút đóng -->
                <Border Padding="25,18,25,22">
                    <Button Height="44" Cursor="Hand"
                            Command="{Binding CloseHoaDonCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="#1A73E8" CornerRadius="10">
                                    <TextBlock Text="Đóng" FontSize="14" FontWeight="SemiBold"
                                               Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
    </Grid>
</UserControl>

    
