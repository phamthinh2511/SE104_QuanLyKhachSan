<Window x:Class="QuanLyKhachSan_SE104.View.PhongView.PhongModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuanLyKhachSan_SE104.View.PhongView"
        mc:Ignorable="d"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="False"
        Title="PhongModal" Height="700" Width="600">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" 
                      CornerRadius="20" 
                      GlassFrameThickness="0" 
                      UseAeroCaptionButtons="True" />
    </WindowChrome.WindowChrome>
     
    <Border Background="White" 
            CornerRadius="20" 
            BorderBrush="#E0E0E0" 
            BorderThickness="1">
        <Grid>
            <Grid VerticalAlignment="Top" Height="300">
                <Border CornerRadius="20,20,0,0" ClipToBounds="True">
                    <Image Source="/Resources/Images/RoomModal.png" 
                           Stretch="Fill" />
                </Border>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#005B" Offset="0.0"/>
                            <GradientStop Color="#CCFFFFFF" Offset="0.7"/>
                            <GradientStop Color="#FFFFFFFF" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>
            <!-- StackPanel Chung-->
            <StackPanel Margin="25,230,25,20">
                <TextBlock Text="Thông tin phòng" 
                           FontSize="32" 
                           FontWeight="Bold" 
                           Foreground="#333333"/>

                <TextBlock Text="Chỉnh sửa trạng thái và giá phòng." 
                           FontSize="14" 
                           Foreground="#777777" 
                           Margin="0,5,0,20"/>
                <!--MPhong và Loại Phòng-->
                <StackPanel Orientation="Horizontal">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Mã Phòng" 
                                   Margin="5, 5, 0, 5"
                                   FontWeight="ExtraBold"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Foreground="#475569"
                                   IsEnabled="False"
                           FontSize="24"/>
                        <Border BorderBrush="Gray" 
                                BorderThickness="1" 
                                CornerRadius="10" 
                                Padding="5" 
                                Width="150" 
                                HorizontalAlignment="Left" 
                                VerticalAlignment="Center">
                            <TextBox BorderThickness="0" 
                                     x:Name="txtbox_MaPhong"
                                 Background="Transparent" 
                                 VerticalAlignment="Center"
                                 Text="{Binding MaPhong, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="28"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Margin="30, 0, 0, 0">
                        <TextBlock Text="Loại Phòng" 
                                   Margin="5, 5, 0, 5"
                                   FontWeight="ExtraBold"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Foreground="#475569"
                           FontSize="24"/>
                        <Border BorderBrush="Gray" 
                                BorderThickness="1" 
                                CornerRadius="10" 
                                Padding="5" 
                                Width="365" 
                                HorizontalAlignment="Left" 
                                VerticalAlignment="Center">
                            <Border.Resources>
                                <SolidColorBrush x:Key="ComboBox.Static.Background" Color="Transparent"/>
                                <SolidColorBrush x:Key="ComboBox.MouseOver.Background" Color="Transparent"/>
                                <SolidColorBrush x:Key="ComboBox.Static.Border" Color="Transparent"/>
                            </Border.Resources>
                            <ComboBox BorderThickness="0" 
                                      Style="{StaticResource ComboBoxStyle}"
                                      x:Name="combobox_LoaiPhong"
                                      ItemsSource="{Binding DanhSachLoaiPhong}"
                                      DisplayMemberPath="TenLoaiPhong"
                                      SelectedItem="{Binding LoaiPhong, UpdateSourceTrigger=PropertyChanged}"  
                                      Background="Transparent" 
                                      VerticalAlignment="Center"
                                      FontSize="28">
                            </ComboBox>
                        </Border>
                    </StackPanel>
                </StackPanel>
                <!-- SoTang && TenPhong-->
                <StackPanel Orientation="Horizontal">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Số Tầng" 
                                    Margin="5, 10, 0, 5"
                                   FontWeight="ExtraBold"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Foreground="#475569"
                           FontSize="24"/>
                        <Border BorderBrush="Gray" 
                                BorderThickness="1" 
                                CornerRadius="10" 
                                Padding="5" 
                                Width="150" 
                                HorizontalAlignment="Left" 
                                VerticalAlignment="Center">
                            <TextBox BorderThickness="0" 
                                     x:Name="txtbox_SoTang"
                                 Background="Transparent" 
                                 VerticalAlignment="Center"
                                 Text="{Binding SoTang, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="28"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Margin="30, 0, 0, 0">
                        <TextBlock Text="Tên Phòng" 
                                   Margin="5, 10, 0, 5"
                                   FontWeight="ExtraBold"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Foreground="#475569"
                           FontSize="24"/>
                        <Border BorderBrush="Gray" 
                                BorderThickness="1" 
                                CornerRadius="10" 
                                Padding="5" 
                                Width="365" 
                                HorizontalAlignment="Left" 
                                VerticalAlignment="Center">
                            <Border.Resources>
                                <SolidColorBrush x:Key="ComboBox.Static.Background" Color="Transparent"/>
                                <SolidColorBrush x:Key="ComboBox.MouseOver.Background" Color="Transparent"/>
                                <SolidColorBrush x:Key="ComboBox.Static.Border" Color="Transparent"/>
                            </Border.Resources>
                            <TextBox BorderThickness="0" 
                                     x:Name="txtbox_TenPhong"
                                 Background="Transparent" 
                                 VerticalAlignment="Center"
                                 Text="{Binding TenPhong, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="28"></TextBox>
                        </Border>
                    </StackPanel>
                </StackPanel>
                <!-- TrangThai && TrangThaiDonDep-->
                <StackPanel Orientation="Horizontal">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Trạng Thái" 
                                    Margin="5, 10, 0, 5"
                                   FontWeight="ExtraBold"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Foreground="#475569"
                           FontSize="24"/>
                        <Border BorderBrush="Gray" 
                                BorderThickness="1" 
                                CornerRadius="10" 
                                Padding="5" 
                                Width="250" 
                                HorizontalAlignment="Left" 
                                VerticalAlignment="Center">
                            <ComboBox BorderThickness="0" 
                                      x:Name="combobox_TrangThai"
                                      Style="{StaticResource ComboBoxStyle}"
                                      Background="Transparent"
                                      SelectedValuePath="Content"
                                      VerticalAlignment="Center"
                                      SelectedValue="{Binding TrangThai, UpdateSourceTrigger=PropertyChanged}"
                                      FontSize="28">
                                <ComboBoxItem Content="Trống"/>
                                <ComboBoxItem Content="Đã đặt"/>
                                <ComboBoxItem Content="Đang ở"/>
                                <ComboBoxItem Content="Quá hạn"/>
                                <ComboBoxItem Content="Cần dọn"/>
                                <ComboBoxItem Content="Bảo trì"/>
                            </ComboBox>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Margin="45, 0, 0, 0">
                        <TextBlock Text="Dọn Dẹp" 
                                   Margin="5, 10, 0, 5"
                                   FontWeight="ExtraBold"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Foreground="#475569"
                           FontSize="24"/>
                        <Border BorderBrush="Gray" 
                                BorderThickness="1" 
                                CornerRadius="10" 
                                Padding="5" 
                                Width="250" 
                                HorizontalAlignment="Left" 
                                VerticalAlignment="Center">
                            <Border.Resources>
                                <SolidColorBrush x:Key="ComboBox.Static.Background" Color="Transparent"/>
                                <SolidColorBrush x:Key="ComboBox.MouseOver.Background" Color="Transparent"/>
                                <SolidColorBrush x:Key="ComboBox.Static.Border" Color="Transparent"/>
                            </Border.Resources>
                            <ComboBox BorderThickness="0"
                                      x:Name="txtbox_TrangThaiDonDep"
                                      Style="{StaticResource ComboBoxStyle}"
                                      Background="Transparent" 
                                      SelectedValuePath="Content"
                                      VerticalAlignment="Center"
                                      SelectedValue="{Binding TrangThaiDonDep, UpdateSourceTrigger=PropertyChanged}"
                                      FontSize="28">
                                <ComboBoxItem Content="Đã dọn"/>
                                <ComboBoxItem Content="Đang dọn"/>
                                <ComboBoxItem Content="Cần dọn"/>
                            </ComboBox>
                        </Border>
                    </StackPanel>
                </StackPanel>
                <!-- Luu && Huy-->
                <StackPanel Margin="0, 25, 0, 0" Orientation="Horizontal" HorizontalAlignment="Right">
                    <StackPanel Orientation="Vertical">
                        <Border BorderBrush="Black" 
                                BorderThickness="1" 
                                CornerRadius="10" 
                                Padding="5" 
                                Width="200" 
                                HorizontalAlignment="Left" 
                                VerticalAlignment="Center">
                            <Button BorderThickness="0" 
                                 Background="Transparent" 
                                 VerticalAlignment="Center"
                                    Content="Hủy"
                                    FontWeight="Bold"
                                 FontSize="28" Click="button_Cancel"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Margin="40, 0, 3, 0">
                        <Border BorderBrush="#005DB6" 
                                BorderThickness="1"
                                Background="#005DB6"
                                CornerRadius="10" 
                                Padding="5" 
                                Width="200" 
                                HorizontalAlignment="Left" 
                                VerticalAlignment="Center">
                            <Border.Resources>
                                <SolidColorBrush x:Key="ComboBox.Static.Background" Color="Transparent"/>
                                <SolidColorBrush x:Key="ComboBox.MouseOver.Background" Color="Transparent"/>
                                <SolidColorBrush x:Key="ComboBox.Static.Border" Color="Transparent"/>
                            </Border.Resources>
                            <Button BorderThickness="0" 
                                    Content="Lưu" 
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Background="#005DB6" 
                                 VerticalAlignment="Center"
                                 FontSize="28" Click="button_Save"></Button>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <Button Content="✕"
                    Click="button_Close"
                    HorizontalAlignment="Right" VerticalAlignment="Top" 
                    Margin="15" Width="15" Height="15"
                    Background="#40000000" Foreground="White"
                    BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="15"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Border>
</Window>