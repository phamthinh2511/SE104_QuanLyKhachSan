<Window x:Class="QuanLyKhachSan_SE104.View.Phong.PhongModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuanLyKhachSan_SE104.View.Phong"
        mc:Ignorable="d"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="False"
        Title="PhongModal" Height="800" Width="600">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" 
                      CornerRadius="20" 
                      GlassFrameThickness="0" 
                      UseAeroCaptionButtons="True" />
    </WindowChrome.WindowChrome>
     
    <Border Background="White" 
            CornerRadius="20" 
            BorderBrush="#E0E0E0" 
            BorderThickness="1">
        <Grid>
            <Grid VerticalAlignment="Top" Height="300">
                <Border CornerRadius="20,20,0,0" ClipToBounds="True">
                    <Image Source="/Resources/Images/RoomModal.png" 
                           Stretch="Fill" />
                </Border>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#005B" Offset="0.0"/>
                            <GradientStop Color="#CCFFFFFF" Offset="0.7"/>
                            <GradientStop Color="#FFFFFFFF" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>

            <StackPanel Margin="25,230,25,20">
                <TextBlock Text="Thông tin phòng" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           Foreground="#333333"/>

                <TextBlock Text="Chỉnh sửa trạng thái và giá phòng." 
                           FontSize="14" 
                           Foreground="#777777" 
                           Margin="0,5,0,20"/>
                <!--MPhong và Loại Phòng-->
                <StackPanel Orientation="Horizontal">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Ma Phòng" 
                                   FontWeight="ExtraBold"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Foreground="#475569"
                           FontSize="24"/>
                        <Border BorderBrush="Gray" 
                                BorderThickness="1" 
                                CornerRadius="10" 
                                Padding="5" 
                                Width="200" 
                                HorizontalAlignment="Left" 
                                VerticalAlignment="Center">
                            <TextBox BorderThickness="0" 
                                 Background="Transparent" 
                                 VerticalAlignment="Center"
                                 Text="{Binding MaPhong}"
                                 IsEnabled="False"
                                 FontSize="24"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Margin="50, 0, 0, 0">
                        <TextBlock Text="Loại Phòng" 
                                   FontWeight="ExtraBold"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Foreground="#475569"
                           FontSize="24"/>
                        <Border BorderBrush="Gray" 
                                BorderThickness="1" 
                                CornerRadius="10" 
                                Padding="5" 
                                Width="290" 
                                HorizontalAlignment="Left" 
                                VerticalAlignment="Center">
                            <Border.Resources>
                                <SolidColorBrush x:Key="ComboBox.Static.Background" Color="Transparent"/>
                                <SolidColorBrush x:Key="ComboBox.MouseOver.Background" Color="Transparent"/>
                                <SolidColorBrush x:Key="ComboBox.Static.Border" Color="Transparent"/>
                            </Border.Resources>
                            <ComboBox BorderThickness="0" 
                                 Background="Transparent" 
                                 VerticalAlignment="Center"
                                 Text="{Binding MaLoaiPhong.TenLoaiPhong}"
                                 FontSize="24"></ComboBox>
                            
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <Button Content="✕"
                    Click="Button_Close"
                    HorizontalAlignment="Right" VerticalAlignment="Top" 
                    Margin="15" Width="30" Height="30"
                    Background="#40000000" Foreground="White"
                    BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="15"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Border>
</Window>