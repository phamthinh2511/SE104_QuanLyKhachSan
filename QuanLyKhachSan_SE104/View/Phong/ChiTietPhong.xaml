<Window x:Class="QuanLyKhachSan_SE104.View.Phong.ChiTietPhong"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:QuanLyKhachSan_SE104.ViewModel.PhongVM"
        Title="Chi Tiết Phòng"
        Height="580" Width="860"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <!-- Nút hành động chính -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="10"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút nguy hiểm (đỏ) -->
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Label nhỏ trên info card -->
        <Style x:Key="InfoLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <!-- Giá trị info card -->
        <Style x:Key="InfoValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>

        <!-- ScrollBar mỏng -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="5"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Window.Resources>

    <!-- Nền bo góc + shadow -->
    <Border CornerRadius="20" Background="White" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.18"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <!-- Header -->
                <RowDefinition Height="Auto"/>
                <!-- Info khách -->
                <RowDefinition Height="*"/>
                <!-- Body -->
                <RowDefinition Height="70"/>
                <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════
                 HEADER — màu thay đổi theo TrangThai
            ══════════════════════════════════════════ -->
            <Border Grid.Row="0" x:Name="HeaderBorder" CornerRadius="20,20,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#1B5E20"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Phong.TrangThai}" Value="0">
                                <Setter Property="Background" Value="#1B5E20"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Phong.TrangThai}" Value="1">
                                <Setter Property="Background" Value="#92400E"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Phong.TrangThai}" Value="2">
                                <Setter Property="Background" Value="#7C3AED"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid Margin="24,0">
                    <!-- Tên phòng + loại -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderIcon" Text="🛏️" FontSize="22" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Phong.TenPhong}"
                                       FontSize="22" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="{Binding Phong.LoaiPhong.TenLoaiPhong}"
                                       FontSize="12" Foreground="#FFFFFF" Opacity="0.7"/>
                        </StackPanel>

                        <!-- Badge trạng thái -->
                        <Border x:Name="StatusBadge" CornerRadius="6" Padding="10,4"
                                Margin="16,0,0,0" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FFFFFF22"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Phong.TrangThai}" Value="0">
                                            <Setter Property="Background" Value="#FFFFFF22"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock x:Name="StatusBadgeText" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="TRỐNG"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Phong.TrangThai}" Value="1">
                                                <Setter Property="Text" Value="ĐÃ ĐẶT"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Phong.TrangThai}" Value="2">
                                                <Setter Property="Text" Value="ĐANG Ở"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <!-- Nút đóng X -->
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="32" Height="32"
                            Command="{Binding ThoatCommand}"
                            Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" CornerRadius="16" Background="Transparent">
                                    <TextBlock Text="✕" FontSize="14" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#FFFFFF22"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════
                 INFO KHÁCH — chỉ hiện khi TrangThai = 1 hoặc 2
            ══════════════════════════════════════════ -->
            <Border Grid.Row="1" Margin="24,16,24,0" CornerRadius="12"
                    Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20,14">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Phong.TrangThai}" Value="1">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Phong.TrangThai}" Value="2">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tên khách -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource InfoLabelStyle}" Text="👤  Khách hàng"/>
                        <TextBlock Style="{StaticResource InfoValueStyle}"
                                   Text="{Binding ChiTietDatPhong.DatPhong.KhachHang.TenKhachHang}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Ngày Check-in -->
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource InfoLabelStyle}" Text="📅  Check-in"/>
                        <TextBlock Style="{StaticResource InfoValueStyle}"
                                   Text="{Binding ChiTietDatPhong.NgayCheckIn, StringFormat='dd/MM/yyyy'}"/>
                    </StackPanel>

                    <!-- Ngày Check-out -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource InfoLabelStyle}" Text="📅  Check-out"/>
                        <TextBlock Style="{StaticResource InfoValueStyle}"
                                   Text="{Binding ChiTietDatPhong.NgayCheckOut, StringFormat='dd/MM/yyyy'}"/>
                    </StackPanel>

                    <!-- Số đêm -->
                    <StackPanel Grid.Column="3">
                        <TextBlock Style="{StaticResource InfoLabelStyle}" Text="🌙  Số đêm"/>
                        <TextBlock Style="{StaticResource InfoValueStyle}"
                                   Text="{Binding SoDem}"/>
                    </StackPanel>

                    <!-- Số người -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Style="{StaticResource InfoLabelStyle}" Text="👥  Số người"/>
                        <TextBlock Style="{StaticResource InfoValueStyle}"
                                   Text="{Binding ChiTietDatPhong.SoNguoi}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════
                 BODY — nội dung theo TrangThai
            ══════════════════════════════════════════ -->
            <Grid Grid.Row="2" Margin="24,16,24,0">

                <!-- ───────────────────────────────────────
                     PHÒNG TRỐNG (TrangThai = 0)
                     Hiện giá + thông tin phòng
                ─────────────────────────────────────────── -->
                <Border CornerRadius="14" Background="#F1F8E9"
                        BorderBrush="#A5D6A7" BorderThickness="1" Padding="30">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Phong.TrangThai}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="🛏️" FontSize="48" HorizontalAlignment="Center"/>
                        <TextBlock Text="Phòng đang trống" FontSize="18" FontWeight="Bold"
                                   Foreground="#2E7D32" HorizontalAlignment="Center" Margin="0,12,0,6"/>
                        <TextBlock Text="{Binding Phong.LoaiPhong.GiaMacDinh, StringFormat='{}{0:#,0}₫ / đêm'}"
                                   FontSize="15" Foreground="#4CAF50" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Chọn hành động bên dưới để tiến hành nhận phòng."
                                   FontSize="12" Foreground="#64748B" HorizontalAlignment="Center"
                                   Margin="0,10,0,0" FontStyle="Italic"/>
                    </StackPanel>
                </Border>

                <!-- ───────────────────────────────────────
                     PHÒNG ĐÃ ĐẶT (TrangThai = 1)
                     Thông tin đặt phòng
                ─────────────────────────────────────────── -->
                <Border CornerRadius="14" Background="#FFFBEB"
                        BorderBrush="#FCD34D" BorderThickness="1" Padding="24">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Phong.TrangThai}" Value="1">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel>
                        <TextBlock Text="Thông tin đặt phòng" FontSize="14" FontWeight="Bold"
                                   Foreground="#92400E" Margin="0,0,0,14"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Mã đặt phòng -->
                            <Border Grid.Row="0" Grid.Column="0" CornerRadius="10"
                                    Background="White" BorderBrush="#FCD34D" BorderThickness="1"
                                    Padding="14,10" Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource InfoLabelStyle}" Text="Mã đặt phòng"/>
                                    <TextBlock Style="{StaticResource InfoValueStyle}"
                                               Text="{Binding ChiTietDatPhong.MaDatPhong}"/>
                                </StackPanel>
                            </Border>

                            <!-- Giá đặt -->
                            <Border Grid.Row="0" Grid.Column="1" CornerRadius="10"
                                    Background="White" BorderBrush="#FCD34D" BorderThickness="1"
                                    Padding="14,10" Margin="8,0,0,8">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource InfoLabelStyle}" Text="Giá đặt"/>
                                    <TextBlock Style="{StaticResource InfoValueStyle}"
                                               Text="{Binding ChiTietDatPhong.GiaDat, StringFormat='{}{0:#,0}₫'}"
                                               Foreground="#D97706"/>
                                </StackPanel>
                            </Border>

                            <!-- Ghi chú -->
                            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                    CornerRadius="10" Background="White"
                                    BorderBrush="#FCD34D" BorderThickness="1"
                                    Padding="14,10">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource InfoLabelStyle}" Text="Ghi chú"/>
                                    <TextBlock Style="{StaticResource InfoValueStyle}"
                                               Text="{Binding ChiTietDatPhong.DatPhong.GhiChu}"
                                               TextWrapping="Wrap" FontWeight="Normal"
                                               Foreground="#64748B"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ───────────────────────────────────────
                     PHÒNG ĐANG Ở (TrangThai = 2)
                     Bảng dịch vụ đã dùng
                ─────────────────────────────────────────── -->
                <Border CornerRadius="14" Background="#F8FAFC"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Phong.TrangThai}" Value="2">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid Margin="16,14,16,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Tiêu đề + nút Thêm dịch vụ -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Dịch vụ đã sử dụng"
                                       FontSize="14" FontWeight="Bold" Foreground="#1B5E20"
                                       VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Background="#16A34A" Foreground="White"
                                    Content="☕  Thêm dịch vụ"
                                    Command="{Binding ThemDichVuCommand}"
                                    CommandParameter="{Binding Phong}"/>
                        </Grid>

                        <!-- Header cột -->
                        <Grid Grid.Row="1" Margin="10,0,10,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Dịch vụ" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                            <TextBlock Grid.Column="1" Text="Đơn giá" FontSize="11" FontWeight="Bold"
                                       Foreground="#64748B" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="SL" FontSize="11" FontWeight="Bold"
                                       Foreground="#64748B" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="Thành tiền" FontSize="11" FontWeight="Bold"
                                       Foreground="#64748B" HorizontalAlignment="Right"/>
                        </Grid>
                        <Border Grid.Row="1" Height="1" Background="#E2E8F0"
                                VerticalAlignment="Bottom" Margin="0,26,0,0"/>

                        <!-- Danh sách dịch vụ -->
                        <Border Grid.Row="2" CornerRadius="10" Background="White"
        BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,4,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4">

                                <ItemsControl ItemsSource="{Binding ChiTietDatPhong.ChiTietDichVus}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="row" Margin="6,3" Padding="10,8" CornerRadius="8">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#F0FDF4"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="110"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="{Binding DichVu.TenDichVu}"
                                                       FontSize="13" Foreground="#1E293B"
                                                       VerticalAlignment="Center"/>         

                                                    <TextBlock Grid.Column="1"
                                                       Text="{Binding DonGia, StringFormat='{}{0:#,0}₫'}"
                                                       FontSize="12" Foreground="#64748B"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>

                                                    <TextBlock Grid.Column="2"
                                                       Text="{Binding SoLuong}"
                                                       FontSize="13" FontWeight="Bold"
                                                       Foreground="#374151"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>

                                                    <TextBlock Grid.Column="3"
                                                       Text="{Binding ThanhTien, StringFormat='{}{0:#,0}₫'}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="#059669"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- Tổng tiền dịch vụ -->
                        <Border Grid.Row="3" CornerRadius="10" Background="#DCFCE7"
                                Padding="14,10" Margin="0,10,0,0">
                            <Grid>
                                <TextBlock Text="Tổng tiền dịch vụ"
                                           FontSize="13" FontWeight="Bold" Foreground="#166534"/>
                                <TextBlock Text="{Binding TongTienDichVuText}"
                                           FontSize="15" FontWeight="Bold" Foreground="#15803D"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════
                 FOOTER — nút hành động theo TrangThai
            ══════════════════════════════════════════ -->
            <Border Grid.Row="3" CornerRadius="0,0,20,20"
                    Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                <Grid Margin="24,0">

                    <!-- PHÒNG TRỐNG: Check-in khách lẻ + Đổi trạng thái dọn dẹp -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Phong.TrangThai}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Button Style="{StaticResource ActionButtonStyle}"
                                Background="#16A34A" Foreground="White"
                                Content="🛎️  Check-in khách lẻ"
                                Command="{Binding CheckInKhachLeCommand}"
                                CommandParameter="{Binding Phong}"
                                Margin="0,0,12,0"/>
                        <Button Style="{StaticResource ActionButtonStyle}"
                                Background="#0284C7" Foreground="White"
                                Content="🧹  Đổi trạng thái dọn dẹp"
                                Command="{Binding DoiTrangThaiDonDepCommand}"
                                CommandParameter="{Binding Phong}"
                                Margin="0,0,12,0"/>
                        <Button Style="{StaticResource ActionButtonStyle}"
                                Background="#6B7280" Foreground="White"
                                Content="✕  Thoát"
                                Command="{Binding ThoatCommand}"/>
                    </StackPanel>

                    <!-- PHÒNG ĐÃ ĐẶT: Check-in + Hủy đặt -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Phong.TrangThai}" Value="1">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Button Style="{StaticResource ActionButtonStyle}"
                                Background="#16A34A" Foreground="White"
                                Content="✅  Check-in khách đã đặt"
                                Command="{Binding CheckInDaDatCommand}"
                                CommandParameter="{Binding Phong}"
                                Margin="0,0,12,0"/>
                        <Button Style="{StaticResource DangerButtonStyle}"
                                Content="❌  Hủy đặt phòng"
                                Command="{Binding HuyDatPhongCommand}"
                                CommandParameter="{Binding Phong}"
                                Margin="0,0,12,0"/>
                        <Button Style="{StaticResource ActionButtonStyle}"
                                Background="#6B7280" Foreground="White"
                                Content="✕  Thoát"
                                Command="{Binding ThoatCommand}"/>
                    </StackPanel>

                    <!-- PHÒNG ĐANG Ở: Đổi phòng + Check-out -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Phong.TrangThai}" Value="2">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Button Style="{StaticResource ActionButtonStyle}"
                                Background="#7C3AED" Foreground="White"
                                Content="🔄  Đổi phòng"
                                Command="{Binding DoiPhongCommand}"
                                CommandParameter="{Binding Phong}"
                                Margin="0,0,12,0"/>
                        <Button Style="{StaticResource ActionButtonStyle}"
                                Background="#1E293B" Foreground="White"
                                Content="📤  Check-out"
                                Command="{Binding CheckOutCommand}"
                                CommandParameter="{Binding Phong}"
                                Margin="0,0,12,0"/>
                        <Button Style="{StaticResource ActionButtonStyle}"
                                Background="#6B7280" Foreground="White"
                                Content="✕  Thoát"
                                Command="{Binding ThoatCommand}"/>
                    </StackPanel>

                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
