<UserControl x:Class="QuanLyKhachSan_SE104.View.Phong.PhongPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuanLyKhachSan_SE104.View.Phong"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100"
             Background="#F8FAFC">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="15" Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.05"/>
            </Border.Effect>
            <DockPanel>
                <TextBox DockPanel.Dock="Left" Width="500" 
                         Tag="Tìm số phòng..." 
                         Style="{StaticResource SearchTextBoxStyle}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ComboBox Style="{StaticResource ModernComboBox}" Width="160" Margin="0,0,10,0" SelectedIndex="0">
                        <ComboBoxItem Content="Tất cả các tầng"/>
                    </ComboBox>
                    <ComboBox Style="{StaticResource ModernComboBox}" Width="160" SelectedIndex="0">
                        <ComboBoxItem Content="Tất cả loại phòng"/>
                    </ComboBox>
                </StackPanel>
            </DockPanel>
        </Border>

        <UniformGrid Grid.Row="1" Columns="7" Margin="-3,0,-3,20">
            <Button Style="{StaticResource StatsFilterButtonStyle}" Background="White"
                    Command="{Binding FilterCommand}" CommandParameter="All">
                <TextBlock Text="{Binding CountTatCa, StringFormat='Tất cả ({0})'}" FontWeight="SemiBold"/>
            </Button>

            <Button Style="{StaticResource StatsFilterButtonStyle}" Background="#4CAF50"
                    Command="{Binding FilterCommand}" CommandParameter="0">
                <TextBlock Text="{Binding CountTrong, StringFormat='Trống ({0})'}" FontWeight="SemiBold"/>
            </Button>

            <Button Style="{StaticResource StatsFilterButtonStyle}" Background="#FF7043"
                    Command="{Binding FilterCommand}" CommandParameter="2">
                <TextBlock Text="{Binding CountDangO, StringFormat='Đang ở ({0})'}" FontWeight="SemiBold"/>
            </Button>

            <Button Style="{StaticResource StatsFilterButtonStyle}" Background="Orange"
                    Command="{Binding FilterCommand}" CommandParameter="3">
                <TextBlock Text="{Binding CountQuaHan, StringFormat='Quá Hạn ({0})'}" FontWeight="SemiBold"/>
            </Button>

            <Button Style="{StaticResource StatsFilterButtonStyle}" Background="Yellow"
                    Command="{Binding FilterCommand}" CommandParameter="1">
                <TextBlock Text="{Binding CountDaDat, StringFormat='Đã đặt ({0})'}" FontWeight="SemiBold"/>
            </Button>

            <Button Style="{StaticResource StatsFilterButtonStyle}" Background="#42A5F5"
                    Command="{Binding FilterCommand}" CommandParameter="4">
                <TextBlock Text="{Binding CountCanDonDep, StringFormat='Cần Dọn ({0})'}" FontWeight="SemiBold"/>
            </Button>

            <Button Style="{StaticResource StatsFilterButtonStyle}" Background="#90A4AE"
                    Command="{Binding FilterCommand}" CommandParameter="5">
                <TextBlock Text="{Binding CountCanDonDep, StringFormat='Bảo Trì ({0})'}" FontWeight="SemiBold"/>
            </Button>
        </UniformGrid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding ListPhong}" 
                         ItemTemplate="{StaticResource RoomCardTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
