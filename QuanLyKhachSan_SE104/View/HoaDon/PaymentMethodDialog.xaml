<Window x:Class="QuanLyKhachSan_SE104.View.HoaDon.PaymentMethodDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chọn phương thức thanh toán"
        Width="380" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6FA"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="MethodBtn" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd"
                                Background="White" CornerRadius="10"
                                BorderBrush="#E5E7EB" BorderThickness="2"
                                Padding="16,14" Margin="0,0,0,10"
                                Cursor="Hand">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1"
                                                  Opacity="0.06" Color="#000"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icon -->
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Tag,
                                               RelativeSource={RelativeSource TemplatedParent}}"
                                           FontSize="22" VerticalAlignment="Center"
                                           Margin="0,0,14,0"/>

                                <!-- Label -->
                                <ContentPresenter Grid.Column="1"
                                                  VerticalAlignment="Center"/>

                                <!-- Radio indicator -->
                                <Ellipse Grid.Column="2" x:Name="dot"
                                         Width="18" Height="18"
                                         Stroke="#D1D5DB" StrokeThickness="2"
                                         Fill="White" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd"   Property="BorderBrush"  Value="#1A56DB"/>
                                <Setter TargetName="bd"   Property="Background"   Value="#EFF6FF"/>
                                <Setter TargetName="dot"  Property="Fill"         Value="#1A56DB"/>
                                <Setter TargetName="dot"  Property="Stroke"       Value="#1A56DB"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#93C5FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="28,24,28,28">

        <!-- Header -->
        <TextBlock Text="Phương thức thanh toán"
                   FontSize="17" FontWeight="Bold"
                   Foreground="#111827" Margin="0,0,0,6"/>
        <TextBlock Text="Chọn cách khách hàng sẽ thanh toán."
                   FontSize="13" Foreground="#6B7280" Margin="0,0,0,20"/>

        <!-- Options -->
        <RadioButton x:Name="RadioCash"
                     Style="{StaticResource MethodBtn}"
                     Tag="💵" IsChecked="True" GroupName="ptt">
            <StackPanel>
                <TextBlock Text="Tiền mặt"
                           FontSize="14" FontWeight="SemiBold" Foreground="#111827"/>
                <TextBlock Text="Khách thanh toán bằng tiền mặt tại quầy"
                           FontSize="12" Foreground="#6B7280"/>
            </StackPanel>
        </RadioButton>

        <RadioButton x:Name="RadioCard"
                     Style="{StaticResource MethodBtn}"
                     Tag="💳" GroupName="ptt">
            <StackPanel>
                <TextBlock Text="Thẻ tín dụng / Ghi nợ"
                           FontSize="14" FontWeight="SemiBold" Foreground="#111827"/>
                <TextBlock Text="Quẹt thẻ qua máy POS"
                           FontSize="12" Foreground="#6B7280"/>
            </StackPanel>
        </RadioButton>

        <RadioButton x:Name="RadioTransfer"
                     Style="{StaticResource MethodBtn}"
                     Tag="🏦" GroupName="ptt">
            <StackPanel>
                <TextBlock Text="Chuyển khoản ngân hàng"
                           FontSize="14" FontWeight="SemiBold" Foreground="#111827"/>
                <TextBlock Text="Khách chuyển khoản qua app ngân hàng"
                           FontSize="12" Foreground="#6B7280"/>
            </StackPanel>
        </RadioButton>

        <!-- Action buttons -->
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Hủy"
                    Height="42" FontSize="13" FontWeight="SemiBold"
                    Foreground="#374151" Background="White"
                    BorderBrush="#D1D5DB" BorderThickness="1.5"
                    Cursor="Hand"
                    Click="OnCancel">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Grid.Column="2" Content="Xác nhận"
                    Height="42" FontSize="13" FontWeight="SemiBold"
                    Foreground="White" Background="#1A56DB"
                    BorderThickness="0" Cursor="Hand"
                    Click="OnConfirm">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1344B0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </StackPanel>
</Window>
