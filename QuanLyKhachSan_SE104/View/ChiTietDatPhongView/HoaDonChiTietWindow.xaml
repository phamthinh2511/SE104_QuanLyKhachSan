<Window x:Class="QuanLyKhachSan_SE104.View.HoaDonChiTietWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chi Tiết Hóa Đơn"
        Height="550" Width="850"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border CornerRadius="16" Background="#F8FAFC" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="2" Opacity="0.15"/>
        </Border.Effect>

        <Grid>
            <Border VerticalAlignment="Top" Height="80" Margin="15,15,15,0"
                    CornerRadius="12" Background="#0EA5E9">
                <Grid Margin="25,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="HÓA ĐƠN THANH TOÁN" FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{Binding HoaDon.MaHoaDonFormatted}" FontSize="13" Foreground="#E0F2FE" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Width="30" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand" Command="{Binding ThoatCommand}">
                            <TextBlock Text="✕" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="15,110,15,130">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="📄" Foreground="#3B82F6" Margin="0,0,8,0"/>
                            <TextBlock Text="THÔNG TIN ĐẶT PHÒNG" FontWeight="Bold" Foreground="#3B82F6" FontSize="13"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Mã đặt phòng" Foreground="#64748B"/>
                            <TextBlock Grid.Column="1" Text="{Binding HoaDon.MaDatPhong}" FontWeight="SemiBold" Foreground="#0F172A"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Khách hàng" Foreground="#64748B"/>
                            <TextBlock Grid.Column="1" Text="{Binding HoaDon.TenKhachHang}" FontWeight="SemiBold" Foreground="#0F172A"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Số điện thoại" Foreground="#64748B"/>
                            <TextBlock Grid.Column="1" Text="{Binding HoaDon.SDT}" FontWeight="SemiBold" Foreground="#0F172A"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Phòng" Foreground="#64748B"/>
                            <TextBlock Grid.Column="1" Text="{Binding HoaDon.TenPhong}" FontWeight="SemiBold" Foreground="#0F172A"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Check-in" Foreground="#64748B"/>
                            <TextBlock Grid.Column="1" Text="{Binding HoaDon.NgayCheckIn, StringFormat='dd/MM/yyyy HH:mm'}" FontWeight="SemiBold" Foreground="#0F172A"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Check-out" Foreground="#64748B"/>
                            <TextBlock Grid.Column="1" Text="{Binding HoaDon.NgayCheckOut, StringFormat='dd/MM/yyyy HH:mm'}" FontWeight="SemiBold" Foreground="#0F172A"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Số đêm" Foreground="#64748B"/>
                            <TextBlock Grid.Column="1" Text="{Binding HoaDon.SoDem, StringFormat='{}{0} đêm'}" FontWeight="SemiBold" Foreground="#0F172A"/>
                        </Grid>
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Nhân viên" Foreground="#64748B"/>
                            <TextBlock Grid.Column="1" Text="{Binding HoaDon.TenNhanVien}" FontWeight="SemiBold" Foreground="#0F172A"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="🛎" Foreground="#3B82F6" Margin="0,0,8,0"/>
                            <TextBlock Text="DANH SÁCH DỊCH VỤ" FontWeight="Bold" Foreground="#3B82F6" FontSize="13"/>
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Height="200">
                            <ItemsControl ItemsSource="{Binding HoaDon.DanhSachDichVu}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding TenDichVu}" FontWeight="SemiBold" Foreground="#334155"/>
                                            <TextBlock Grid.Column="1" Text="{Binding SoLuong}" Foreground="#64748B" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding ThanhTien, StringFormat='{}{0:N0}₫'}" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>

            <Border VerticalAlignment="Bottom" Height="100" Margin="15,0,15,15"
                    Background="White" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="💰" Foreground="#3B82F6" Margin="0,0,8,0"/>
                            <TextBlock Text="TỔNG HỢP CHI PHÍ" FontWeight="Bold" Foreground="#3B82F6" FontSize="13"/>
                        </StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Tiền phòng" Foreground="#64748B"/>
                            <TextBlock Grid.Column="1" Text="{Binding HoaDon.TienPhong, StringFormat='{}{0:N0}₫'}" FontWeight="SemiBold" Foreground="#0F172A"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Tiền dịch vụ" Foreground="#64748B"/>
                            <TextBlock Grid.Column="1" Text="{Binding HoaDon.TienDichVu, StringFormat='{}{0:N0}₫'}" FontWeight="SemiBold" Foreground="#0F172A"/>
                        </Grid>
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Tiền cọc" Foreground="#64748B"/>
                            <TextBlock Grid.Column="1" Text="{Binding HoaDon.TienCoc, StringFormat='- {0:N0}₫'}" FontWeight="SemiBold" Foreground="#10B981"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="TỔNG THANH TOÁN" FontSize="12" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Right" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding HoaDon.TongThanhToan, StringFormat='{}{0:N0}₫'}" FontSize="32" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>