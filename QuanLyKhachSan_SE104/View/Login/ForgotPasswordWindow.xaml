<Window x:Class="QuanLyKhachSan_SE104.View.Login.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quên mật khẩu - Hotel Manager"
        Height="520" Width="860"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="PlaceholderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8899B6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="38,0,0,0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style x:Key="InputBorder" TargetType="Border">
            <Setter Property="Background" Value="#3D5080"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="BorderBrush" Value="#5A70A8"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="StepLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C5D3EC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0F1E3D" Offset="0.0"/>
                <GradientStop Color="#1A2E66" Offset="0.5"/>
                <GradientStop Color="#1D1A4D" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <!-- Draggable -->
            <Border Background="Transparent" MouseLeftButtonDown="Window_MouseDown"/>

            <!-- Close -->
            <Button Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="12" Cursor="Hand" Click="CloseButton_Click" Panel.ZIndex="10">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#A6B8D6"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="16">
                                        <TextBlock Text="✕" FontSize="15" Foreground="{TemplateBinding Foreground}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Decorative circles -->
            <Ellipse Width="240" Height="240" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-60,-60,0,0" Opacity="0.04">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#3B82F6" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="200" Height="200" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,-50,-50" Opacity="0.05">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#8B5CF6" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Center content -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- Logo small -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,22">
                    <Border Background="#3B82F6" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#3B82F6" Opacity="0.5" BlurRadius="10" ShadowDepth="0"/>
                        </Border.Effect>
                        <TextBlock Text="🏨" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Hotel Manager" Foreground="White" FontSize="20" FontWeight="Bold"
                               VerticalAlignment="Center" FontFamily="Segoe UI"/>
                </StackPanel>

                <!-- Card -->
                <Border CornerRadius="14" Width="420" Padding="32,28">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#263566" Offset="0"/>
                            <GradientStop Color="#1E2B55" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#5A70B8" Offset="0"/>
                            <GradientStop Color="#2A3A6A" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.BorderThickness>1</Border.BorderThickness>
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Opacity="0.4" BlurRadius="30" ShadowDepth="8"/>
                    </Border.Effect>

                    <StackPanel>
                        <!-- Icon + Title -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="🔑" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Quên mật khẩu" Foreground="White" FontSize="22"
                                       FontWeight="Bold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Nhập tên đăng nhập để đặt lại mật khẩu." Foreground="#8EA5CC"
                                   FontSize="13" Margin="0,0,0,24" FontFamily="Segoe UI"/>

                        <!-- Step 1: Username lookup -->
                        <StackPanel x:Name="pnlStep1">
                            <TextBlock Text="Tên đăng nhập" Style="{StaticResource StepLabel}"/>
                            <Border Style="{StaticResource InputBorder}" Margin="0,0,0,18">
                                <Grid>
                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                               Foreground="#6880A8" VerticalAlignment="Center" Margin="13,0,0,0"/>
                                    <TextBox x:Name="txtFindUsername" Background="Transparent" BorderThickness="0"
                                             Foreground="White" FontSize="14" VerticalContentAlignment="Center"
                                             Margin="38,0,10,0" CaretBrush="White" FontFamily="Segoe UI"
                                             TextChanged="TxtFindUsername_TextChanged"
                                             KeyDown="TxtFindUsername_KeyDown"/>
                                    <TextBlock x:Name="lblFindUserPlaceholder" Text="Nhập tên đăng nhập"
                                               Style="{StaticResource PlaceholderText}"/>
                                </Grid>
                            </Border>

                            <!-- Error for step 1 -->
                            <Border x:Name="pnlFindError" Background="#2D1515" CornerRadius="6" Padding="12,8"
                                    Margin="0,0,0,14" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚠" Foreground="#FF6B6B" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="lblFindError" Foreground="#FF9999" FontSize="13"
                                               FontFamily="Segoe UI" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Info found user -->
                            <Border x:Name="pnlFoundUser" Background="#0D2040" CornerRadius="8" Padding="14,10"
                                    Margin="0,0,0,18" Visibility="Collapsed"
                                    BorderBrush="#2A4A7A" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👤" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <StackPanel>
                                        <TextBlock x:Name="lblFoundName" Foreground="White" FontSize="14"
                                                   FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                        <TextBlock x:Name="lblFoundRole" Foreground="#8EA5CC" FontSize="12" FontFamily="Segoe UI"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Find button -->
                            <Button x:Name="btnFind" Content="Tìm tài khoản" Height="46" Foreground="White"
                                    FontSize="15" FontWeight="SemiBold" Cursor="Hand" Click="BtnFind_Click"
                                    FontFamily="Segoe UI">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#3B82F6"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                        <Border.Effect>
                                                            <DropShadowEffect Color="#3B82F6" Opacity="0.3" BlurRadius="10" ShadowDepth="0"/>
                                                        </Border.Effect>
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#2563EB"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="#334477"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>

                        <!-- Step 2: New password -->
                        <StackPanel x:Name="pnlStep2" Visibility="Collapsed">
                            <!-- New Password -->
                            <TextBlock Text="Mật khẩu mới" Style="{StaticResource StepLabel}"/>
                            <Border Style="{StaticResource InputBorder}" Margin="0,0,0,18">
                                <Grid>
                                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                               Foreground="#6880A8" VerticalAlignment="Center" Margin="13,0,0,0"/>
                                    <PasswordBox x:Name="txtNewPassword" Background="Transparent" BorderThickness="0"
                                                 Foreground="White" FontSize="14" VerticalContentAlignment="Center"
                                                 Margin="38,0,10,0" CaretBrush="White" FontFamily="Segoe UI"
                                                 PasswordChanged="TxtNewPassword_Changed"
                                                 KeyDown="TxtNewPassword_KeyDown"/>
                                    <TextBlock x:Name="lblNewPwdPlaceholder" Text="Nhập mật khẩu mới"
                                               Style="{StaticResource PlaceholderText}"/>
                                </Grid>
                            </Border>

                            <!-- Confirm Password -->
                            <TextBlock Text="Xác nhận mật khẩu" Style="{StaticResource StepLabel}"/>
                            <Border Style="{StaticResource InputBorder}" Margin="0,0,0,18">
                                <Grid>
                                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                               Foreground="#6880A8" VerticalAlignment="Center" Margin="13,0,0,0"/>
                                    <PasswordBox x:Name="txtConfirmPassword" Background="Transparent" BorderThickness="0"
                                                 Foreground="White" FontSize="14" VerticalContentAlignment="Center"
                                                 Margin="38,0,10,0" CaretBrush="White" FontFamily="Segoe UI"
                                                 PasswordChanged="TxtNewPassword_Changed"
                                                 KeyDown="TxtNewPassword_KeyDown"/>
                                    <TextBlock x:Name="lblConfirmPwdPlaceholder" Text="Nhập lại mật khẩu"
                                               Style="{StaticResource PlaceholderText}"/>
                                </Grid>
                            </Border>

                            <!-- Password strength hint -->
                            <TextBlock x:Name="lblStrength" FontSize="12" FontFamily="Segoe UI"
                                       Margin="0,-8,0,14" Foreground="#8EA5CC"/>

                            <!-- Error for step 2 -->
                            <Border x:Name="pnlResetError" Background="#2D1515" CornerRadius="6" Padding="12,8"
                                    Margin="0,0,0,14" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚠" Foreground="#FF6B6B" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="lblResetError" Foreground="#FF9999" FontSize="13"
                                               FontFamily="Segoe UI" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Buttons row -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Back -->
                                <Button Grid.Column="0" Content="← Quay lại" Height="46" Foreground="#A6B8D6"
                                        FontSize="14" FontWeight="SemiBold" Cursor="Hand" Click="BtnBack_Click"
                                        FontFamily="Segoe UI">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#2A3A6A"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                                                BorderBrush="#3A4E80" BorderThickness="1">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#334477"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Reset -->
                                <Button Grid.Column="2" x:Name="btnReset" Content="Đặt lại mật khẩu" Height="46"
                                        Foreground="White" FontSize="14" FontWeight="SemiBold" Cursor="Hand"
                                        Click="BtnReset_Click" FontFamily="Segoe UI">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#10B981"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                            <Border.Effect>
                                                                <DropShadowEffect Color="#10B981" Opacity="0.3" BlurRadius="10" ShadowDepth="0"/>
                                                            </Border.Effect>
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#059669"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Background" Value="#224433"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </StackPanel>

                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>
