<Window x:Class="QuanLyKhachSan_SE104.View.Login.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login - Hotel Manager" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    
    <Window.Resources>
        <!-- Style for Placeholder Text -->
        <Style x:Key="PlaceholderTextBlock" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8899B6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="35,0,0,0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="10">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1D305A" Offset="0.0"/>
                <GradientStop Color="#223B75" Offset="0.5"/>
                <GradientStop Color="#2A245C" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <!-- Draggable Area -->
            <Border Background="Transparent" MouseLeftButtonDown="Window_MouseDown" Panel.ZIndex="-1"/>
            
            <!-- Close Button (Optional, since WindowStyle=None) -->
            <Button Content="✕" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top" 
                    Margin="10" Background="Transparent" Foreground="White" BorderThickness="0" 
                    FontSize="16" Cursor="Hand" Click="CloseButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#44FFFFFF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                
                <!-- Logo -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,30">
                    <Border Background="#3B82F6" CornerRadius="8" Width="40" Height="40" Margin="0,0,10,0">
                        <TextBlock Text="🏨" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                    </Border>
                    <TextBlock Text="Hotel Manager" Foreground="White" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Login Card -->
                <Border Background="#344883" CornerRadius="12" Width="420" Padding="30"
                        BorderBrush="#44FFFFFF" BorderThickness="1">
                    <!-- Glassmorphism slight effect -->
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="20" ShadowDepth="5"/>
                    </Border.Effect>
                    
                    <StackPanel>
                        <!-- Header -->
                        <TextBlock Text="Đăng nhập" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBlock Text="Chào mừng trở lại! Vui lòng đăng nhập." Foreground="#A6B8D6" FontSize="13" Margin="0,0,0,25"/>

                        <!-- Username Field -->
                        <TextBlock Text="Tên đăng nhập" Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Border Background="#4A5E95" CornerRadius="6" Height="45" Margin="0,0,0,20">
                            <Grid>
                                <TextBlock Text="👤" Foreground="#8899B6" FontSize="16" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                <TextBox x:Name="txtUsername" Background="Transparent" BorderThickness="0" Foreground="White" 
                                         FontSize="14" VerticalContentAlignment="Center" Margin="35,0,10,0" CaretBrush="White"
                                         TextChanged="TxtUsername_TextChanged"/>
                                <TextBlock x:Name="lblUsernamePlaceholder" Text="admin" Style="{StaticResource PlaceholderTextBlock}"/>
                            </Grid>
                        </Border>

                        <!-- Password Field -->
                        <TextBlock Text="Mật khẩu" Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Border Background="#4A5E95" CornerRadius="6" Height="45" Margin="0,0,0,25">
                            <Grid>
                                <TextBlock Text="🔒" Foreground="#8899B6" FontSize="16" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                <PasswordBox x:Name="txtPassword" Background="Transparent" BorderThickness="0" Foreground="White" 
                                             FontSize="14" VerticalContentAlignment="Center" Margin="35,0,40,0" CaretBrush="White"
                                             PasswordChanged="TxtPassword_PasswordChanged"/>
                                <TextBlock x:Name="lblPasswordPlaceholder" Text="........" Style="{StaticResource PlaceholderTextBlock}"/>
                                <!-- Eye Icon Toggle -->
                                <Button HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Width="40" Cursor="Hand" Click="TogglePasswordVisibility_Click">
                                    <TextBlock Text="👁" Foreground="#8899B6" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="0,6,6,0">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Error Message -->
                        <TextBlock x:Name="lblError" Foreground="#FF6B6B" FontSize="13" Margin="0,-15,0,15" Visibility="Collapsed" HorizontalAlignment="Center"/>

                        <!-- Login Button -->
                        <Button x:Name="btnLogin" Content="Đăng nhập" Height="45" Foreground="White" FontSize="15" FontWeight="Bold" Cursor="Hand" Click="BtnLogin_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#3B82F6"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#2563EB"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#1D4ED8"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>
