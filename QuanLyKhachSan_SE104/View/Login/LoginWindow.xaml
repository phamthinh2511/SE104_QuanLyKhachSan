<Window x:Class="QuanLyKhachSan_SE104.View.Login.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng nhập - Hotel Manager" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <Style x:Key="PlaceholderTextBlock" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8899B6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="38,0,0,0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="InputBorder" TargetType="Border">
            <Setter Property="Background" Value="#3D5080"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="BorderBrush" Value="#5A70A8"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#60A5FA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                            <Setter Property="TextDecorations" Value="Underline"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0F1E3D" Offset="0.0"/>
                <GradientStop Color="#1A2E66" Offset="0.5"/>
                <GradientStop Color="#1D1A4D" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <!-- Draggable Area (behind everything) -->
            <Border Background="Transparent" MouseLeftButtonDown="Window_MouseDown"/>

            <!-- Close Button -->
            <Button Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="12" Cursor="Hand" Click="CloseButton_Click" Panel.ZIndex="10">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#A6B8D6"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="16">
                                        <TextBlock Text="✕" FontSize="15" Foreground="{TemplateBinding Foreground}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Decorative circles -->
            <Ellipse Width="300" Height="300" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-80,-80,0,0" Opacity="0.04">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#3B82F6" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="250" Height="250" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,-60,-60" Opacity="0.05">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#8B5CF6" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Center Content -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- Logo -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,28">
                    <Border Background="#3B82F6" CornerRadius="10" Width="44" Height="44" Margin="0,0,12,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#3B82F6" Opacity="0.5" BlurRadius="12" ShadowDepth="0"/>
                        </Border.Effect>
                        <TextBlock Text="🏨" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Hotel Manager" Foreground="White" FontSize="26" FontWeight="Bold"
                               VerticalAlignment="Center" FontFamily="Segoe UI"/>
                </StackPanel>

                <!-- Login Card -->
                <Border CornerRadius="14" Width="420" Padding="32,28">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#263566" Offset="0"/>
                            <GradientStop Color="#1E2B55" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#5A70B8" Offset="0"/>
                            <GradientStop Color="#2A3A6A" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.BorderThickness>1</Border.BorderThickness>
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Opacity="0.4" BlurRadius="30" ShadowDepth="8"/>
                    </Border.Effect>

                    <StackPanel>
                        <!-- Header -->
                        <TextBlock Text="Đăng nhập" Foreground="White" FontSize="22" FontWeight="Bold"
                                   Margin="0,0,0,4" FontFamily="Segoe UI"/>
                        <TextBlock Text="Chào mừng trở lại! Vui lòng đăng nhập." Foreground="#8EA5CC"
                                   FontSize="13" Margin="0,0,0,24" FontFamily="Segoe UI"/>

                        <!-- Username Field -->
                        <TextBlock Text="Tên đăng nhập" Foreground="#C5D3EC" FontSize="12"
                                   FontWeight="SemiBold" Margin="0,0,0,7" FontFamily="Segoe UI"/>
                        <Border Style="{StaticResource InputBorder}" Margin="0,0,0,18">
                            <Grid>
                                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           Foreground="#6880A8" VerticalAlignment="Center" Margin="13,0,0,0"/>
                                <TextBox x:Name="txtUsername" Background="Transparent" BorderThickness="0"
                                         Foreground="White" FontSize="14" VerticalContentAlignment="Center"
                                         Margin="38,0,10,0" CaretBrush="White" FontFamily="Segoe UI"
                                         TextChanged="TxtUsername_TextChanged"
                                         KeyDown="TxtInput_KeyDown"/>
                                <TextBlock x:Name="lblUsernamePlaceholder" Text="Nhập tên đăng nhập"
                                           Style="{StaticResource PlaceholderTextBlock}"/>
                            </Grid>
                        </Border>

                        <!-- Password Field -->
                        <TextBlock Text="Mật khẩu" Foreground="#C5D3EC" FontSize="12"
                                   FontWeight="SemiBold" Margin="0,0,0,7" FontFamily="Segoe UI"/>
                        <Border Style="{StaticResource InputBorder}" Margin="0,0,0,10">
                            <Grid>
                                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           Foreground="#6880A8" VerticalAlignment="Center" Margin="13,0,0,0"/>
                                <!-- Password box (hidden text) -->
                                <PasswordBox x:Name="txtPassword" Background="Transparent" BorderThickness="0"
                                             Foreground="White" FontSize="14" VerticalContentAlignment="Center"
                                             Margin="38,0,44,0" CaretBrush="White" FontFamily="Segoe UI"
                                             PasswordChanged="TxtPassword_PasswordChanged"
                                             KeyDown="TxtInput_KeyDown"/>
                                <!-- Plain text box (for show password) -->
                                <TextBox x:Name="txtPasswordVisible" Background="Transparent" BorderThickness="0"
                                         Foreground="White" FontSize="14" VerticalContentAlignment="Center"
                                         Margin="38,0,44,0" CaretBrush="White" FontFamily="Segoe UI"
                                         Visibility="Collapsed"
                                         TextChanged="TxtPasswordVisible_TextChanged"
                                         KeyDown="TxtInput_KeyDown"/>
                                <TextBlock x:Name="lblPasswordPlaceholder" Text="Nhập mật khẩu"
                                           Style="{StaticResource PlaceholderTextBlock}"/>
                                <!-- Eye Toggle -->
                                <Button x:Name="btnEye" HorizontalAlignment="Right" Width="40" Height="46"
                                        Cursor="Hand" Click="TogglePasswordVisibility_Click">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}">
                                                            <TextBlock x:Name="EyeIcon" Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets"
                                                                       FontSize="16" Foreground="#6880A8"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Forgot Password Link -->
                        <StackPanel HorizontalAlignment="Right" Margin="0,0,0,20">
                            <Button Content="Quên mật khẩu?" Style="{StaticResource LinkButton}"
                                    Click="ForgotPassword_Click"/>
                        </StackPanel>

                        <!-- Error Message -->
                        <Border x:Name="pnlError" Background="#2D1515" CornerRadius="6" Padding="12,8"
                                Margin="0,0,0,14" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠" Foreground="#FF6B6B" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblError" Foreground="#FF9999" FontSize="13"
                                           FontFamily="Segoe UI" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Success Message -->
                        <Border x:Name="pnlSuccess" Background="#0D2D1A" CornerRadius="6" Padding="12,8"
                                Margin="0,0,0,14" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✓" Foreground="#4ADE80" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblSuccess" Foreground="#86EFAC" FontSize="13"
                                           FontFamily="Segoe UI" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Login Button -->
                        <Button x:Name="btnLogin" Height="46" Foreground="White" FontSize="15"
                                FontWeight="SemiBold" Cursor="Hand" Click="BtnLogin_Click"
                                FontFamily="Segoe UI">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#3B82F6"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#3B82F6" Opacity="0.3" BlurRadius="10" ShadowDepth="0"/>
                                                    </Border.Effect>
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#2563EB"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#1D4ED8"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Background" Value="#334477"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="lblLoginBtnText" Text="Đăng nhập" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>
