<UserControl x:Class="QuanLyKhachSan_SE104.View.BaoCao.BaoCaoPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="#F5F6FA">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#DDDDDD" Opacity="0.5"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Tháng:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
                <ComboBox Width="90" Margin="0,0,20,0" VerticalAlignment="Center"
                          ItemsSource="{Binding DanhSachThang}" SelectedItem="{Binding ThangSelected}"/>

                <TextBlock Text="Năm:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
                <ComboBox Width="90" Margin="0,0,20,0" VerticalAlignment="Center"
                          ItemsSource="{Binding DanhSachNam}" SelectedItem="{Binding NamSelected}"/>

                <TextBlock Text="Tiêu chí phân tích:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
                <ComboBox Width="160" Margin="0,0,20,0" VerticalAlignment="Center"
                          ItemsSource="{Binding DanhSachTieuChi}" SelectedItem="{Binding TieuChiSelected}"/>

                <Button Content="THỐNG KÊ" Command="{Binding ThongKeCommand}" 
                        Width="120" Height="35" Margin="10,0,0,0" Background="#2196F3" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="#4CAF50" CornerRadius="10" Padding="20" Margin="0,0,0,15" HorizontalAlignment="Left" Width="320">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Color="#AAAAAA" Opacity="0.5"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="TỔNG DOANH THU" Foreground="White" FontSize="13" FontWeight="SemiBold" Opacity="0.9"/>
                <TextBlock Text="{Binding TongDoanhThu, StringFormat={}{0:N0} VNĐ}" 
                           Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="6*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="15" Margin="0,0,15,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#DDDDDD" Opacity="0.5"/>
                </Border.Effect>
                <Grid>
                    <TextBlock Text="Biểu đồ doanh thu" FontSize="16" FontWeight="Bold" Foreground="#333" VerticalAlignment="Top"/>
                    <lvc:CartesianChart Series="{Binding ChartSeries}" Margin="0,40,0,0">
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Labels="{Binding ChartLabels}"></lvc:Axis>
                        </lvc:CartesianChart.AxisX>
                    </lvc:CartesianChart>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="15">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#DDDDDD" Opacity="0.5"/>
                </Border.Effect>
                <Grid>
                    <TextBlock Text="Chi tiết giao dịch doanh thu" FontSize="16" FontWeight="Bold" Foreground="#333" Margin="0,0,0,15"/>
                    <DataGrid Margin="0,35,0,0" ItemsSource="{Binding DanhSachBaoCao}" 
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              Background="White" RowHeight="35" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STT" Binding="{Binding STT}" Width="50" />
                            <DataGridTextColumn Header="Mã GD" Binding="{Binding MaGiaoDich}" Width="85" />
                            <DataGridTextColumn Header="Loại / Dịch Vụ" Binding="{Binding TenLoai}" Width="*" />
                            <DataGridTextColumn Header="Ngày lập" Binding="{Binding NgayTao, StringFormat=dd/MM/yyyy}" Width="105" />
                            <DataGridTextColumn Header="Doanh thu" Binding="{Binding DoanhThu, StringFormat={}{0:N0} đ}" Width="135" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>