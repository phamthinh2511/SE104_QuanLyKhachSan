<UserControl x:Class="QuanLyKhachSan_SE104.View.BaoCao.BaoCaoPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns:vm="clr-namespace:QuanLyKhachSan_SE104.ViewModel.BaoCao"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="#F8FAFC">
    <UserControl.DataContext>
        <vm:BaoCaoViewModel/>
    </UserControl.DataContext>
    
    <UserControl.Resources>
        <Style x:Key="KPICard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,20,0"/>
        </Style>
        <Style x:Key="TabRadioButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="16">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                       FontWeight="Medium" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- MAIN CONTAINER for Export -->
    <Grid x:Name="printContainer" Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- KPIs -->
            <RowDefinition Height="Auto"/> <!-- Tabs -->
            <RowDefinition Height="*"/>    <!-- Content -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Báo cáo &amp; Thống kê" FontSize="24" FontWeight="Bold" Foreground="#1E293B"/>
                <TextBlock Text="Phân tích và thông tin chi tiết về hiệu suất khách sạn" Foreground="#64748B" FontSize="14" Margin="0,4,0,0"/>
            </StackPanel>

            <ComboBox Grid.Column="1" Width="120" Height="40" Margin="0,0,12,0"
                      ItemsSource="{Binding TimeFilters}"
                      SelectedItem="{Binding SelectedTimeFilter}"
                      VerticalContentAlignment="Center" Padding="12,0">
            </ComboBox>

            <Button Grid.Column="2" Content="⬇ Xuất báo cáo" Height="40" Padding="16,0"
                    Background="White" Foreground="#1E293B" BorderBrush="#E2E8F0" BorderThickness="1"
                    Cursor="Hand" Click="BtnExportPdf_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <!-- KPI CARDS -->
        <Grid Grid.Row="1" Margin="0,0,-20,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Doanh thu -->
            <Border Grid.Column="0" Style="{StaticResource KPICard}">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Tổng doanh thu" Foreground="#64748B" FontSize="13"/>
                        <TextBlock Text="{Binding TongDoanhThu, StringFormat={}{0:N0} ₫}" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,8,0,0"/>
                    </StackPanel>
                    <Border Width="40" Height="40" Background="#DBEAFE" CornerRadius="8" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <TextBlock Text="₫" Foreground="#2563EB" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Lấp đầy -->
            <Border Grid.Column="1" Style="{StaticResource KPICard}">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Tỷ lệ lấp đầy" Foreground="#64748B" FontSize="13"/>
                        <TextBlock Text="{Binding TyLeLapDay, StringFormat={}{0}%}" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,8,0,0"/>
                    </StackPanel>
                    <Border Width="40" Height="40" Background="#F3E8FF" CornerRadius="8" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <TextBlock Text="📅" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Khách -->
            <Border Grid.Column="2" Style="{StaticResource KPICard}">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Tổng khách" Foreground="#64748B" FontSize="13"/>
                        <TextBlock Text="{Binding TongKhach, StringFormat={}{0:N0}}" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,8,0,0"/>
                    </StackPanel>
                    <Border Width="40" Height="40" Background="#FEF3C7" CornerRadius="8" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <TextBlock Text="👤" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- TABS -->
        <Border Grid.Row="2" Background="White" CornerRadius="20" Padding="4" HorizontalAlignment="Left" Margin="0,0,0,20"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="Phân tích doanh thu" Style="{StaticResource TabRadioButton}" IsChecked="True" Checked="Tab_Checked" Tag="TabDoanhThu"/>
                <RadioButton Content="Tỉ lệ bận phòng" Style="{StaticResource TabRadioButton}" Checked="Tab_Checked" Tag="TabBanPhong"/>
                <RadioButton Content="Sử dụng dịch vụ" Style="{StaticResource TabRadioButton}" Checked="Tab_Checked" Tag="TabDichVu"/>
                <RadioButton Content="Năng suất phòng" Style="{StaticResource TabRadioButton}" Checked="Tab_Checked" Tag="TabNangSuat"/>
            </StackPanel>
        </Border>

        <!-- CONTENT AREA -->
        <Grid Grid.Row="3">
            <!-- TAB 1: DOANH THU -->
            <Grid x:Name="TabDoanhThu" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Doanh thu" FontWeight="Bold" FontSize="16" Foreground="#1E293B" Margin="0,0,0,16"/>
                        <lvc:CartesianChart Grid.Row="1" Series="{Binding RevenueSeries}" LegendLocation="Bottom">
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis Labels="{Binding RevenueLabels}"/>
                            </lvc:CartesianChart.AxisX>
                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis LabelFormatter="{Binding Formatter}"/>
                            </lvc:CartesianChart.AxisY>
                        </lvc:CartesianChart>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Xu hướng doanh thu" FontWeight="Bold" FontSize="16" Foreground="#1E293B" Margin="0,0,0,16"/>
                        <lvc:CartesianChart Grid.Row="1" Series="{Binding TrendSeries}" LegendLocation="None">
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis Labels="{Binding RevenueLabels}"/>
                            </lvc:CartesianChart.AxisX>
                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis LabelFormatter="{Binding Formatter}"/>
                            </lvc:CartesianChart.AxisY>
                        </lvc:CartesianChart>
                    </Grid>
                </Border>
            </Grid>

            <!-- TAB 2: BẬN PHÒNG -->
            <Grid x:Name="TabBanPhong" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Tỷ lệ lấp đầy (%)" FontWeight="Bold" FontSize="16" Foreground="#1E293B" Margin="0,0,0,16"/>
                        <lvc:CartesianChart Grid.Row="1" Series="{Binding OccupancySeries}" LegendLocation="None">
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis Labels="{Binding RevenueLabels}"/>
                            </lvc:CartesianChart.AxisX>
                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis MinValue="0" MaxValue="100"/>
                            </lvc:CartesianChart.AxisY>
                        </lvc:CartesianChart>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Lượng khách" FontWeight="Bold" FontSize="16" Foreground="#1E293B" Margin="0,0,0,16"/>
                        <!-- Reusing revenue layout for demo, ideally we bind to GuestSeries -->
                        <lvc:CartesianChart Grid.Row="1" Series="{Binding GuestSeries}" LegendLocation="None">
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis Labels="{Binding RevenueLabels}"/>
                            </lvc:CartesianChart.AxisX>
                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis LabelFormatter="{Binding Formatter}"/>
                            </lvc:CartesianChart.AxisY>
                        </lvc:CartesianChart>
                    </Grid>
                </Border>
            </Grid>

            <!-- TAB 3: DỊCH VỤ -->
            <Grid x:Name="TabDichVu" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Tỷ lệ sử dụng dịch vụ" FontWeight="Bold" FontSize="16" Foreground="#1E293B" Margin="0,0,0,16"/>
                        <lvc:PieChart Grid.Row="1" Series="{Binding ServiceUsageSeries}" LegendLocation="Right" InnerRadius="40"/>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Doanh thu theo dịch vụ" FontWeight="Bold" FontSize="16" Foreground="#1E293B" Margin="0,0,0,16"/>
                        <!-- Dùng ServiceBarSeries (ColumnSeries) — không dùng ServiceUsageSeries (PieSeries) -->
                        <lvc:CartesianChart Grid.Row="1" Series="{Binding ServiceBarSeries}" LegendLocation="None">
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis Labels="{Binding ServiceBarLabels}"/>
                            </lvc:CartesianChart.AxisX>
                        </lvc:CartesianChart>
                    </Grid>
                </Border>
            </Grid>

            <!-- TAB 4: NĂNG SUẤT PHÒNG -->
            <Grid x:Name="TabNangSuat" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Booking theo loại phòng" FontWeight="Bold" FontSize="16" Foreground="#1E293B" Margin="0,0,0,16"/>
                        <lvc:CartesianChart Grid.Row="1" Series="{Binding RoomProductivitySeries}" LegendLocation="None">
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis Labels="{Binding RoomProductivityLabels}"/>
                            </lvc:CartesianChart.AxisX>
                        </lvc:CartesianChart>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Trạng thái phòng hiện tại" FontWeight="Bold" FontSize="16" Foreground="#1E293B" Margin="0,0,0,16"/>
                        <!-- Dùng RoomStatusPieSeries — không dùng ServiceUsageSeries -->
                        <lvc:PieChart Grid.Row="1" Series="{Binding RoomStatusPieSeries}" LegendLocation="Bottom"/>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</UserControl>
