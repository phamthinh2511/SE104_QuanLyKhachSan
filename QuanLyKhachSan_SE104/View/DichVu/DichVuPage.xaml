<Window x:Class="QuanLyKhachSan_SE104.View.DichVu.DichVuPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:QuanLyKhachSan_SE104.ViewModel.DichVuVM"
        Title="Thêm Dịch Vụ" Height="670" Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <!-- Nút tròn tăng/giảm -->
        <Style x:Key="RoundButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="14"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút Lưu / Thoát -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Width" Value="130"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="10"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ScrollBar mỏng -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="5"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Window.Resources>

    <!-- Nền mờ + bo góc -->
    <Border CornerRadius="20" Background="White" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.18"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <!-- Header -->
                <RowDefinition Height="*"/>
                <!-- Body 2 cột -->
                <RowDefinition Height="120"/>
                <!-- Footer buttons -->
            </Grid.RowDefinitions>

            <!-- ══ HEADER ══ -->
            <Border Grid.Row="0" CornerRadius="20,20,0,0"
                    Background="#1B5E20">
                <Grid>
                    <TextBlock Text="🍽️  Thêm Dịch Vụ" 
                               FontSize="22" FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                    <!-- Nút đóng X -->
                    <Button Content="✕" 
                            HorizontalAlignment="Right" Margin="0,0,20,0"
                            Width="32" Height="32" VerticalAlignment="Center"
                            Foreground="White" FontSize="14" FontWeight="Bold"
                            Command="{Binding ThoatCommand}"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" CornerRadius="16" Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#2E7D32"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- ══ BODY ══ -->
            <Grid Grid.Row="1" Margin="20,15,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── CỘT TRÁI: Danh sách dịch vụ ── -->
                <Border Grid.Column="0" CornerRadius="14"
                        Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid Margin="14,12,14,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- Label -->
                            <RowDefinition Height="Auto"/>
                            <!-- Filter bar -->
                            <RowDefinition Height="*"/>
                            <!-- List -->
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Danh sách dịch vụ"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="#1B5E20" Margin="0,0,0,10"/>

                        <!-- ComboBox + Search -->
                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding DanhSachNhom}"
                                      SelectedItem="{Binding NhomDuocChon}"
                                      Height="36"
                                      Background="White"
                                      BorderBrush="#D1D5DB"
                                      BorderThickness="1"
                                      Padding="10,0">
                                <ComboBox.Template>
                                    <ControlTemplate TargetType="ComboBox">
                                        <Grid>
                                            <ToggleButton IsChecked="{Binding IsDropDownOpen, 
                                                          Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                          ClickMode="Press">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border x:Name="bd" CornerRadius="8"
                                                                Background="White"
                                                                BorderBrush="#D1D5DB"
                                                                BorderThickness="1">
                                                            <Grid Margin="10,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="20"/>
                                                                </Grid.ColumnDefinitions>
                                                                <ContentPresenter Grid.Column="0"
                                                                    Content="{Binding SelectedItem, 
                                                                    RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                    VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="1" Text="▾"
                                                                           Foreground="#6B7280"
                                                                           VerticalAlignment="Center"
                                                                           HorizontalAlignment="Center"/>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="bd" Property="BorderBrush" Value="#4CAF50"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>
                                            <Popup IsOpen="{Binding IsDropDownOpen, 
                                                   RelativeSource={RelativeSource TemplatedParent}}"
                                                   Placement="Bottom" AllowsTransparency="True">
                                                <Border Background="White" CornerRadius="8"
                                                        BorderBrush="#E2E8F0" BorderThickness="1"
                                                        Margin="0,4,0,0">
                                                    <ItemsPresenter/>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                    </ControlTemplate>
                                </ComboBox.Template>
                            </ComboBox>

                            <!-- Search box -->
                            <Border Grid.Column="2" CornerRadius="8"
                                    Background="White"
                                    BorderBrush="#D1D5DB" BorderThickness="1"
                                    Height="36">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🔍" VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Foreground="#9CA3AF" FontSize="14"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Background="Transparent"
                                             VerticalContentAlignment="Center"
                                             Foreground="#374151" FontSize="13"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Danh sách dịch vụ -->
                        <Border Grid.Row="2" CornerRadius="10"
                                Background="White"
                                BorderBrush="#E2E8F0" BorderThickness="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4">
                                <ItemsControl ItemsSource="{Binding DanhSachDichVu}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="row"
                                                    Margin="6,3" Padding="12,10"
                                                    CornerRadius="8"
                                                    Background="Transparent">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="90"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Tên + loại -->
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DichVu.TenDichVu}"
                                                                   FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="#1E293B"/>
                                                        <Border Background="#DCFCE7" CornerRadius="4"
                                                                Padding="5,1" HorizontalAlignment="Left"
                                                                Margin="0,3,0,0">
                                                            <TextBlock Text="{Binding TenLoai}"
                                                                       FontSize="10" Foreground="#166534"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- Giá -->
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding DonGiaText}"
                                                               FontSize="13" FontWeight="Bold"
                                                               Foreground="#059669"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"/>

                                                    <!-- Nút - Số lượng + -->
                                                    <StackPanel Grid.Column="2"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center"
                                                                HorizontalAlignment="Right">
                                                        <Button Style="{StaticResource RoundButtonStyle}"
                                                                Background="#FEE2E2" Foreground="#DC2626"
                                                                Content="−"
                                                                Command="{Binding DataContext.GiamSoLuongCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"/>

                                                        <TextBlock Text="{Binding SoLuong}"
                                                                   Width="28"
                                                                   TextAlignment="Center"
                                                                   FontSize="14" FontWeight="Bold"
                                                                   Foreground="#1E293B"
                                                                   VerticalAlignment="Center"/>

                                                        <Button Style="{StaticResource RoundButtonStyle}"
                                                                Background="#DCFCE7" Foreground="#16A34A"
                                                                Content="+"
                                                                Command="{Binding DataContext.TangSoLuongCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding SoLuong}" Value="0">
                                                    <Setter TargetName="row" Property="Background" Value="Transparent"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="row" Property="Background" Value="#F0FDF4"/>
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>

                <!-- ── Divider ── -->
                <Border Grid.Column="1" Width="1" Background="#E2E8F0"
                        VerticalAlignment="Stretch" Margin="0,10"/>

                <!-- ── CỘT PHẢI: Dịch vụ đã chọn ── -->
                <Border Grid.Column="2" CornerRadius="14"
                        Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid Margin="14,12,14,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Dịch vụ đã chọn"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="#1B5E20" Margin="0,0,0,10"/>

                        <!-- Header cột -->
                        <Border Grid.Row="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="10,0,10,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Dịch vụ" FontSize="11" FontWeight="Bold"
                                               Foreground="#64748B"/>
                                    <TextBlock Grid.Column="1" Text="SL" FontSize="11"
                                               FontWeight="Bold" Foreground="#64748B"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="Thành tiền" FontSize="11"
                                               FontWeight="Bold" Foreground="#64748B"
                                               HorizontalAlignment="Right"/>
                                </Grid>

                                <Border Grid.Row="0" Height="1" Background="#E2E8F0"
                                        VerticalAlignment="Bottom" Margin="0,28,0,0"/>

                                <!-- Danh sách đã chọn -->
                                <Border Grid.Row="1" CornerRadius="10"
                                        Background="White"
                                        BorderBrush="#E2E8F0" BorderThickness="1"
                                        Margin="0,4,0,0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4">
                                        <ItemsControl ItemsSource="{Binding DanhSachDaChon}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="rowRight"
                                                            Margin="6,3" Padding="10,10"
                                                            CornerRadius="8" Background="Transparent">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="50"/>
                                                                <ColumnDefinition Width="80"/>
                                                                <ColumnDefinition Width="30"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding DichVu.TenDichVu}"
                                                                       FontSize="13" Foreground="#1E293B"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"/>

                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding SoLuong}"
                                                                       FontSize="13" FontWeight="Bold"
                                                                       Foreground="#374151"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>

                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding ThanhTienText}"
                                                                       FontSize="13" FontWeight="SemiBold"
                                                                       Foreground="#059669"
                                                                       HorizontalAlignment="Right"
                                                                       VerticalAlignment="Center"/>

                                                            <!-- Nút xóa -->
                                                            <Button Grid.Column="3"
                                                                    Content="✕"
                                                                    Width="22" Height="22"
                                                                    FontSize="11" FontWeight="Bold"
                                                                    Foreground="White"
                                                                    Background="#EF4444"
                                                                    Cursor="Hand"
                                                                    VerticalAlignment="Center"
                                                                    HorizontalAlignment="Center"
                                                                    Command="{Binding DataContext.XoaDichVuCommand,
                                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="bd" CornerRadius="11"
                                                                                Background="{TemplateBinding Background}">
                                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                                              VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="bd" Property="Background" Value="#DC2626"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="rowRight" Property="Background" Value="#F0FDF4"/>
                                                        </Trigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Tổng tiền -->
                        <Border Grid.Row="2" CornerRadius="10"
                                Background="#DCFCE7" Padding="14,10"
                                Margin="0,10,0,0">
                            <Grid>
                                <TextBlock Text="Tổng cộng"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="#166534"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TongTienText}"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="#15803D"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══ FOOTER ══ -->
            <Border Grid.Row="2" CornerRadius="0,0,20,20"
                    Background="#F8FAFC"
                    BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Recording Time Selection -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                        <TextBlock Text="📅 Thời gian ghi nhận:" FontSize="13" FontWeight="SemiBold" Foreground="#1B5E20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <DatePicker SelectedDate="{Binding ThoiGianGhiNhanDate, Mode=TwoWay}" Width="150" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding HoursList}" SelectedValue="{Binding ThoiGianGhiNhanHour, Mode=TwoWay}" Width="60" Height="28" Margin="10,0,0,0" VerticalContentAlignment="Center"/>
                        <TextBlock Text=":" VerticalAlignment="Center" Margin="5,0" Foreground="#1B5E20" FontWeight="Bold"/>
                        <ComboBox ItemsSource="{Binding MinutesList}" SelectedValue="{Binding ThoiGianGhiNhanMinute, Mode=TwoWay}" Width="60" Height="28" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Row 1: Action Buttons -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,0,0,10">
                        <Button Style="{StaticResource ActionButtonStyle}"
                                Content="💾  Lưu"
                                Background="#16A34A" Foreground="White"
                                Command="{Binding LuuCommand}"
                                Margin="0,0,15,0"/>
                        <Button Style="{StaticResource ActionButtonStyle}"
                                Content="✕  Thoát"
                                Background="#6B7280" Foreground="White"
                                Command="{Binding ThoatCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>