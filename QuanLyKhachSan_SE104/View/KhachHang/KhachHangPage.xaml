<UserControl x:Class="QuanLyKhachSan_SE104.View.KhachHang.KhachHangPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuanLyKhachSan_SE104.View.KhachHang"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER & SEARCH BAR -->
        <Grid Margin="0,0,0,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="QUẢN LÝ KHÁCH HÀNG" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                <TextBlock Text="Tra cứu và cập nhật thông tin khách lưu trú" Foreground="{StaticResource SecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Thanh tìm kiếm Real-time -->
            <TextBox Grid.Column="1" Style="{StaticResource SearchTextBoxStyle}" 
                     Tag="Nhập tên khách hàng để tìm kiếm..." 
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     VerticalAlignment="Bottom" Height="45"/>
        </Grid>

        <!-- BẢNG DỮ LIỆU -->
        <Border Grid.Row="1" Background="White" CornerRadius="15" BorderBrush="#E2E8F0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.05"/>
            </Border.Effect>

            <DataGrid ItemsSource="{Binding DanhSachKhachHang}"
                      Margin="15"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      RowHeight="50"
                      GridLinesVisibility="None"
                      Background="White"
                      BorderThickness="0"
                      AlternatingRowBackground="#F8FAFC">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Họ Tên" Binding="{Binding HoTen}" Width="*" FontWeight="SemiBold"/>

                    <!-- FORMAT GIỚI TÍNH TỪ SỐ SANG CHỮ -->
                    <DataGridTemplateColumn Header="Giới tính" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Nam"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GioiTinh}" Value="1">
                                                    <Setter Property="Text" Value="Nữ"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="CCCD/Passport" Binding="{Binding CCCD_Passport}" Width="150"/>
                    <DataGridTextColumn Header="SĐT" Binding="{Binding SDT}" Width="130"/>
                    <DataGridTextColumn Header="Quốc tịch" Binding="{Binding QuocTich}" Width="120"/>
                    <DataGridTextColumn Header="Địa chỉ" Binding="{Binding DiaChi}" Width="*"/>

                    <!-- CỘT THAO TÁC (CHỈ CÓ NÚT SỬA) -->
                    <DataGridTemplateColumn Header="Thao tác" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Sửa" 
                                        Width="80" Height="32"
                                        Style="{StaticResource EditButtonStyle}"
                                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
