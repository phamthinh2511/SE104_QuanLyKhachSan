<UserControl x:Class="QuanLyKhachSan_SE104.View.ChiTietDatPhong.ChiTietDatPhongPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="#F8FAFC">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header + Search + Button -->
            <RowDefinition Height="*"/>
            <!-- Bảng danh sách -->
        </Grid.RowDefinitions>

        <!-- ══ HEADER ROW ══ -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Search box -->
            <Border Grid.Column="0" Width="280" HorizontalAlignment="Left"
                    Background="White" CornerRadius="10"
                    BorderBrush="#E2E8F0" BorderThickness="1" Height="40">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔍" VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Foreground="#94A3B8" FontSize="14"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0" Background="Transparent"
                             VerticalContentAlignment="Center"
                             Foreground="#374151" FontSize="13"
                             Tag="Tìm theo tên khách hàng">
                        <!-- Placeholder -->
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush Stretch="None" AlignmentX="Left">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="Tìm theo tên khách hàng"
                                                                   Foreground="#94A3B8"
                                                                   FontStyle="Italic"
                                                                   FontSize="13"
                                                                   Margin="2,0,0,0"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>
            </Border>

            <!-- Nút Đặt Phòng -->
            <Button Grid.Column="1"
                    Content="Đặt phòng"
                    Command="{Binding DatPhongCommand}"
                    Height="40" Padding="22,0"
                    FontSize="14" FontWeight="SemiBold"
                    Foreground="White" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="10" Background="#16A34A">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#15803D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- ══ BẢNG DANH SÁCH ══ -->
        <Border Grid.Row="1" Background="White" CornerRadius="14"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.05"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <!-- Header bảng -->
                    <RowDefinition Height="*"/>
                    <!-- Rows -->
                </Grid.RowDefinitions>

                <!-- Header bảng -->
                <Border Grid.Row="0" CornerRadius="14,14,0,0" Background="#F1F5F9">
                    <Grid Margin="20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Số phiếu thuê"
                                   FontSize="12" FontWeight="Bold" Foreground="#475569"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Tên khách hàng"
                                   FontSize="12" FontWeight="Bold" Foreground="#475569"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="Ngày lập phiếu"
                                   FontSize="12" FontWeight="Bold" Foreground="#475569"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="Tên nhân viên"
                                   FontSize="12" FontWeight="Bold" Foreground="#475569"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="Chi tiết"
                                   FontSize="12" FontWeight="Bold" Foreground="#475569"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="5" Text="Xóa"
                                   FontSize="12" FontWeight="Bold" Foreground="#475569"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Rows -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ListDatPhong}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="rowBorder"
                                        BorderBrush="#F1F5F9" BorderThickness="0,0,0,1"
                                        Background="Transparent">
                                    <Grid Margin="20,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Số phiếu -->
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding MaDatPhong}"
                                                   FontSize="13" Foreground="#374151"
                                                   VerticalAlignment="Center"/>

                                        <!-- Tên khách -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding TenKhachHang}"
                                                   FontSize="13" Foreground="#374151"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>

                                        <!-- Ngày lập -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding NgayDat, StringFormat='dd/MM/yyyy'}"
                                                   FontSize="13" Foreground="#374151"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>

                                        <!-- Nhân viên -->
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding TenNhanVien}"
                                                   FontSize="13" Foreground="#374151"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>

                                        <!-- Nút Chi tiết -->
                                        <Button Grid.Column="4"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Width="32" Height="32"
                                                Cursor="Hand"
                                                Command="{Binding DataContext.XemChiTietCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" CornerRadius="8"
                                                            Background="#1E293B" Width="32" Height="32">
                                                        <TextBlock Text="···" Foreground="White"
                                                                   FontSize="14" FontWeight="Bold"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,0,4"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#334155"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!-- Nút Xóa -->
                                        <Button Grid.Column="5"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Width="32" Height="32"
                                                Cursor="Hand"
                                                Command="{Binding DataContext.XoaCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" CornerRadius="8"
                                                            Background="#EF4444" Width="32" Height="32">
                                                        <TextBlock Text="✕" Foreground="White"
                                                                   FontSize="13" FontWeight="Bold"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#DC2626"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="rowBorder" Property="Background" Value="#F8FAFC"/>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>