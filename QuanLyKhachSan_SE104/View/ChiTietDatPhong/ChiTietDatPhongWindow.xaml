<Window
        x:Class="QuanLyKhachSan_SE104.View.ChiTietDatPhong.ChiTietDatPhongWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chi Tiết Phiếu Thuê"
        Height="480" Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border CornerRadius="16" Background="White" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.15"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <!-- Header -->
                <RowDefinition Height="Auto"/>
                <!-- Thông tin tổng -->
                <RowDefinition Height="*"/>
                <!-- Bảng chi tiết -->
                <RowDefinition Height="64"/>
                <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- ══ HEADER ══ -->
            <Border Grid.Row="0" CornerRadius="16,16,0,0" Background="#F8FAFC"
                    BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <TextBlock Text="{Binding TieuDe}"
                           FontSize="20" FontWeight="Bold"
                           Foreground="#3B82F6"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
            </Border>

            <!-- ══ THÔNG TIN TỔNG ══ -->
            <Border Grid.Row="1" Margin="25,16,25,0"
                    Background="#F8FAFC" CornerRadius="12"
                    BorderBrush="#E2E8F0" BorderThickness="1"
                    Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Khách hàng -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="👤" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding TenKhachHang}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="#1E293B" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Ngày đặt -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="📅" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding NgayDat}"
                                   FontSize="13" Foreground="#64748B"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Nhân viên -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="👷" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding TenNhanVien}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="#1E293B" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══ BẢNG CHI TIẾT PHÒNG ══ -->
            <Border Grid.Row="2" Margin="25,14,25,0"
                    Background="White" CornerRadius="12"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header bảng -->
                    <Border Grid.Row="0" CornerRadius="12,12,0,0" Background="#EFF6FF">
                        <Grid Margin="20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Số phòng" FontSize="12" FontWeight="Bold"
                                       Foreground="#3B82F6" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Ngày bắt đầu" FontSize="12" FontWeight="Bold"
                                       Foreground="#3B82F6" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Ngày kết thúc" FontSize="12" FontWeight="Bold"
                                       Foreground="#3B82F6" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="Số người" FontSize="12" FontWeight="Bold"
                                       Foreground="#3B82F6" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Rows chi tiết -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding DanhSachChiTiet}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="row"
                                            BorderBrush="#F1F5F9" BorderThickness="0,0,0,1"
                                            Background="Transparent"
                                            Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" 
                                                          Command="{Binding DataContext.XemHoaDonCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding}"/>        
                                        </Border.InputBindings>
                                        <Grid Margin="20,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding TenPhong}"
                                                       FontSize="13" Foreground="#374151"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding NgayCheckIn, StringFormat='dd/MM/yyyy HH:mm'}"
                                                       FontSize="13" Foreground="#374151"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding NgayCheckOut, StringFormat='dd/MM/yyyy HH:mm'}"
                                                       FontSize="13" Foreground="#374151"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding SoNguoi}"
                                                       FontSize="13" Foreground="#374151"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="row" Property="Background" Value="#F8FAFC"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ══ FOOTER ══ -->
            <Border Grid.Row="3" CornerRadius="0,0,16,16"
                    Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                <Button Content="Thoát"
                        HorizontalAlignment="Right" Margin="0,0,25,0"
                        Width="100" Height="38"
                        FontSize="13" FontWeight="SemiBold"
                        Foreground="White" Cursor="Hand"
                        Command="{Binding ThoatCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" CornerRadius="8" Background="#64748B">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#475569"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>