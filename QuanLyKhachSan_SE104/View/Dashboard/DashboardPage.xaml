<UserControl x:Class="QuanLyKhachSan_SE104.View.Dashboard.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:model="clr-namespace:QuanLyKhachSan_SE104.Model"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100"
             Background="#F8FAFC">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title + Filter row -->
            <RowDefinition Height="*"/>    <!-- Timeline table card -->
        </Grid.RowDefinitions>

        <!-- ══ HEADER & FILTER ROW ══ -->
        <Grid Grid.Row="0" Margin="0,0,0,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Title -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="Lịch trình hôm nay" FontSize="26" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Xem chi tiết check-in, check-out và sử dụng dịch vụ của các phòng" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Filters list (horizontal pill buttons) -->
            <ListBox Grid.Column="1" ItemsSource="{Binding FiltersList}" SelectedValue="{Binding SelectedFilter}"
                     Background="Transparent" BorderThickness="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="#E2E8F0"/>
                        <Setter Property="Foreground" Value="#475569"/>
                        <Setter Property="Padding" Value="18,8"/>
                        <Setter Property="Margin" Value="0,0,8,0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="18" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#0F172A"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- Date Picker wrapper -->
            <Border Grid.Column="2" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12,6" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📅 " VerticalAlignment="Center" FontSize="14"/>
                    <DatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay}" Width="150" BorderThickness="0" Background="Transparent" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══ TIMELINE TABLE CARD ══ -->
        <Border Grid.Row="1" Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="2" Opacity="0.03"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header Row -->
                    <RowDefinition Height="*"/>    <!-- Data rows -->
                </Grid.RowDefinitions>

                <!-- Header Row -->
                <Grid Grid.Row="0" Height="50" Background="#F8FAFC">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border BorderBrush="#E2E8F0" BorderThickness="0,0,1,1" Padding="15,0">
                        <TextBlock Text="Phòng" FontWeight="Bold" FontSize="13" Foreground="#475569" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>

                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1" Padding="5,0"><TextBlock Text="08:00" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Grid.Column="1" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1" Padding="5,0"><TextBlock Text="09:00" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Grid.Column="2" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1" Padding="5,0"><TextBlock Text="10:00" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Grid.Column="3" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1" Padding="5,0"><TextBlock Text="11:00" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Grid.Column="4" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1" Padding="5,0"><TextBlock Text="12:00" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Grid.Column="5" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1" Padding="5,0"><TextBlock Text="13:00" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Grid.Column="6" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1" Padding="5,0"><TextBlock Text="14:00" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Grid.Column="7" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1" Padding="5,0"><TextBlock Text="15:00" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Grid.Column="8" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1" Padding="5,0"><TextBlock Text="16:00" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Grid.Column="9" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1" Padding="5,0"><TextBlock Text="17:00" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Grid.Column="10" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1" Padding="5,0"><TextBlock Text="18:00" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Grid.Column="11" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1" Padding="5,0"><TextBlock Text="19:00" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Grid.Column="12" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1" Padding="5,0"><TextBlock Text="20:00" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Grid.Column="13" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1" Padding="5,0"><TextBlock Text="21:00" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Grid.Column="14" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="5,0"><TextBlock Text="22:00" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    </Grid>
                </Grid>

                <!-- Scrollable room events list -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,5">
                    <Grid>
                        <!-- Main items container -->
                        <ItemsControl ItemsSource="{Binding ScheduleRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="65">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Room Name Column -->
                                        <Border BorderBrush="#F1F5F9" BorderThickness="0,0,1,1" Background="#F8FAFC" Padding="15,0">
                                            <TextBlock Text="{Binding RoomName}" FontWeight="Bold" FontSize="13" Foreground="#1E293B" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>

                                        <!-- Hour cell timeline with overlay cards -->
                                        <Grid Grid.Column="1">
                                            <!-- Sub-grid for borders -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" BorderBrush="#F1F5F9" BorderThickness="0,0,1,1"/>
                                                <Border Grid.Column="1" BorderBrush="#F1F5F9" BorderThickness="0,0,1,1"/>
                                                <Border Grid.Column="2" BorderBrush="#F1F5F9" BorderThickness="0,0,1,1"/>
                                                <Border Grid.Column="3" BorderBrush="#F1F5F9" BorderThickness="0,0,1,1"/>
                                                <Border Grid.Column="4" BorderBrush="#F1F5F9" BorderThickness="0,0,1,1"/>
                                                <Border Grid.Column="5" BorderBrush="#F1F5F9" BorderThickness="0,0,1,1"/>
                                                <Border Grid.Column="6" BorderBrush="#F1F5F9" BorderThickness="0,0,1,1"/>
                                                <Border Grid.Column="7" BorderBrush="#F1F5F9" BorderThickness="0,0,1,1"/>
                                                <Border Grid.Column="8" BorderBrush="#F1F5F9" BorderThickness="0,0,1,1"/>
                                                <Border Grid.Column="9" BorderBrush="#F1F5F9" BorderThickness="0,0,1,1"/>
                                                <Border Grid.Column="10" BorderBrush="#F1F5F9" BorderThickness="0,0,1,1"/>
                                                <Border Grid.Column="11" BorderBrush="#F1F5F9" BorderThickness="0,0,1,1"/>
                                                <Border Grid.Column="12" BorderBrush="#F1F5F9" BorderThickness="0,0,1,1"/>
                                                <Border Grid.Column="13" BorderBrush="#F1F5F9" BorderThickness="0,0,1,1"/>
                                                <Border Grid.Column="14" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1"/>
                                            </Grid>

                                            <!-- Overlay events container -->
                                            <ItemsControl ItemsSource="{Binding Events}" VerticalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                        </Grid>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Grid.Column" Value="{Binding StartColumn}"/>
                                                        <Setter Property="Grid.ColumnSpan" Value="{Binding ColumnSpan}"/>
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding ColorBrush}" BorderBrush="{Binding BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="4,2" Height="50" VerticalAlignment="Center">
                                                            <Border.Effect>
                                                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.05"/>
                                                            </Border.Effect>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="4"/> <!-- Left color bar -->
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <Border Grid.Column="0" Background="{Binding IndicatorColor}" CornerRadius="3,0,0,3"/>

                                                                <Grid Grid.Column="1" Margin="8,3,8,3">
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="*"/>
                                                                    </Grid.RowDefinitions>

                                                                    <TextBlock Grid.Row="0" Text="{Binding CustomerName}" FontWeight="Bold" FontSize="11" Foreground="{Binding TextColor}" TextTrimming="CharacterEllipsis"/>
                                                                    
                                                                    <Grid Grid.Row="1" VerticalAlignment="Bottom">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="{Binding Description}" FontSize="9.5" Foreground="{Binding TextColor}" Opacity="0.8" TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding TimeDisplay}" FontWeight="Bold" FontSize="9.5" Foreground="{Binding TextColor}" Margin="5,0,0,0"/>
                                                                    </Grid>
                                                                </Grid>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty state placeholder -->
                        <TextBlock Text="📭 Không có hoạt động check-in, check-out hay dịch vụ nào trong ngày này."
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,50,0,0"
                                   Foreground="#94A3B8" FontSize="14" FontWeight="SemiBold" FontStyle="Italic">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ScheduleRows.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>