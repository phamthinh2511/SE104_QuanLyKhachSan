<UserControl x:Class="QuanLyKhachSan_SE104.View.Dashboard.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:model="clr-namespace:QuanLyKhachSan_SE104.Model"
             mc:Ignorable="d"
             d:DesignHeight="750" d:DesignWidth="1100"
             Background="#F8FAFC">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <!-- ══════════════════════════════════════════════ -->
        <!-- MAIN CONTENT                                  -->
        <!-- ══════════════════════════════════════════════ -->
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="15" Margin="0,0,0,15">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.05"/>
                </Border.Effect>
                <DockPanel>
                    <TextBox DockPanel.Dock="Left" Width="500"
                             Tag="Tìm số phòng..."
                             Style="{StaticResource SearchTextBoxStyle}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ComboBox Style="{StaticResource ModernComboBox}" Width="160" Margin="0,0,10,0" SelectedIndex="0">
                            <ComboBoxItem Content="Tất cả các tầng"/>
                        </ComboBox>
                        <ComboBox Style="{StaticResource ModernComboBox}" Width="160" SelectedIndex="0">
                            <ComboBoxItem Content="Tất cả loại phòng"/>
                        </ComboBox>
                    </StackPanel>
                </DockPanel>
            </Border>

            <UniformGrid Grid.Row="1" Columns="7" Margin="-3,0,-3,20">
                <Button Style="{StaticResource StatsFilterButtonStyle}" Background="White"
                        Command="{Binding FilterCommand}" CommandParameter="All">
                    <TextBlock Text="{Binding CountTatCa, StringFormat='Tất cả ({0})'}" FontWeight="SemiBold"/>
                </Button>
                <Button Style="{StaticResource StatsFilterButtonStyle}" Background="#4CAF50"
                        Command="{Binding FilterCommand}" CommandParameter="0">
                    <TextBlock Text="{Binding CountTrong, StringFormat='Trống ({0})'}" FontWeight="SemiBold"/>
                </Button>
                <Button Style="{StaticResource StatsFilterButtonStyle}" Background="#FF7043"
                        Command="{Binding FilterCommand}" CommandParameter="2">
                    <TextBlock Text="{Binding CountDangO, StringFormat='Đang ở ({0})'}" FontWeight="SemiBold"/>
                </Button>
                <Button Style="{StaticResource StatsFilterButtonStyle}" Background="Orange"
                        Command="{Binding FilterCommand}" CommandParameter="Overdue">
                    <TextBlock Text="Quá hạn (0)" FontWeight="SemiBold"/>
                </Button>
                <Button Style="{StaticResource StatsFilterButtonStyle}" Background="Yellow"
                        Command="{Binding FilterCommand}" CommandParameter="1">
                    <TextBlock Text="{Binding CountDaDat, StringFormat='Đã đặt ({0})'}" FontWeight="SemiBold"/>
                </Button>
                <Button Style="{StaticResource StatsFilterButtonStyle}" Background="#42A5F5">
                    <TextBlock Text="Cần dọn dẹp" FontWeight="SemiBold"/>
                </Button>
                <Button Style="{StaticResource StatsFilterButtonStyle}" Background="#90A4AE">
                    <TextBlock Text="Bảo trì" FontWeight="SemiBold"/>
                </Button>
            </UniformGrid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding ListPhong}"
                             ItemTemplate="{StaticResource RoomCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ══════════════════════════════════════════════ -->
        <!-- POPUP: THAO TÁC NHANH                        -->
        <!-- ══════════════════════════════════════════════ -->
        <Grid Visibility="{Binding IsPopupOpen, Converter={StaticResource BoolToVis}}"
              Background="#80000000">
            <Grid.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding ClosePopupCommand}"/>
            </Grid.InputBindings>

            <Border Background="White" CornerRadius="16" Padding="30"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    MinWidth="360" MaxWidth="420">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.25"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Header -->
                    <DockPanel Margin="0,0,0,20">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="{Binding SelectedPhong.TenPhong, StringFormat='Phòng {0}'}"
                                       FontSize="24" FontWeight="Bold" Foreground="#1E293B"/>
                            <TextBlock Text="{Binding SelectedPhong.LoaiPhong.TenLoaiPhong}"
                                       FontSize="14" Foreground="#64748B" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Content="✕" FontSize="18"
                                VerticalAlignment="Top" Cursor="Hand"
                                Command="{Binding ClosePopupCommand}"
                                Background="Transparent" BorderThickness="0" Foreground="#94A3B8"/>
                    </DockPanel>

                    <Separator Background="#E2E8F0" Margin="0,0,0,20"/>
                    <TextBlock Text="Thao tác nhanh" FontSize="14" FontWeight="SemiBold"
                               Foreground="#64748B" Margin="0,0,0,12"/>

                    <!-- Phòng TRỐNG (0) -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPhong.TrangThaiThue}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Margin="0,0,0,10" Height="48" Cursor="Hand"
                                Command="{Binding CheckInKhachLeCommand}" CommandParameter="{Binding SelectedPhong}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="#4CAF50" CornerRadius="10">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="📥" FontSize="16" Margin="0,0,8,0"/>
                                            <TextBlock Text="Check-in khách lẻ" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Margin="0,0,0,10" Height="48" Cursor="Hand"
                                Command="{Binding ToggleDonDepCommand}" CommandParameter="{Binding SelectedPhong}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="#42A5F5" CornerRadius="10">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="🧹" FontSize="16" Margin="0,0,8,0"/>
                                            <TextBlock Text="Đổi trạng thái dọn dẹp" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <!-- Phòng ĐANG Ở (2) -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPhong.TrangThaiThue}" Value="2">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Margin="0,0,0,10" Height="48" Cursor="Hand"
                                Command="{Binding AddServiceCommand}" CommandParameter="{Binding SelectedPhong}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="#FF9800" CornerRadius="10">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="☕" FontSize="16" Margin="0,0,8,0"/>
                                            <TextBlock Text="Thêm dịch vụ" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Margin="0,0,0,10" Height="48" Cursor="Hand"
                                Command="{Binding ChangeRoomCommand}" CommandParameter="{Binding SelectedPhong}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="#42A5F5" CornerRadius="10">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="🔄" FontSize="16" Margin="0,0,8,0"/>
                                            <TextBlock Text="Đổi phòng" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Margin="0,0,0,10" Height="48" Cursor="Hand"
                                Command="{Binding CheckOutCommand}" CommandParameter="{Binding SelectedPhong}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="#E53935" CornerRadius="10">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="📤" FontSize="16" Margin="0,0,8,0"/>
                                            <TextBlock Text="Check-out (Trả phòng)" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <!-- Phòng ĐÃ ĐẶT (1) -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPhong.TrangThaiThue}" Value="1">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Margin="0,0,0,10" Height="48" Cursor="Hand"
                                Command="{Binding CheckInDaDatCommand}" CommandParameter="{Binding SelectedPhong}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="#4CAF50" CornerRadius="10">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="📥" FontSize="16" Margin="0,0,8,0"/>
                                            <TextBlock Text="Check-in cho khách đã đặt" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════ -->
        <!-- POPUP: THÊM DỊCH VỤ                          -->
        <!-- ══════════════════════════════════════════════ -->
        <Grid Visibility="{Binding IsServicePopupOpen, Converter={StaticResource BoolToVis}}"
              Background="#80000000">
            <Grid.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding CloseServicePopupCommand}"/>
            </Grid.InputBindings>

            <Border Background="White" CornerRadius="16" Padding="0"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Width="700" MinHeight="450">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.25"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="16,16,0,0" Padding="25,18">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Thêm dịch vụ" FontSize="20" FontWeight="Bold" Foreground="#1E293B"/>
                                <TextBlock Text="{Binding SelectedPhong.TenPhong, StringFormat='Phòng {0}'}"
                                           FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Content="✕" FontSize="18"
                                    VerticalAlignment="Top" Cursor="Hand"
                                    Command="{Binding CloseServicePopupCommand}"
                                    Background="Transparent" BorderThickness="0" Foreground="#94A3B8"/>
                        </DockPanel>
                    </Border>

                    <!-- Body: 2 cột -->
                    <Grid Grid.Row="1" Margin="25,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Cột trái: Danh sách dịch vụ có sẵn -->
                        <Border Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Danh sách dịch vụ"
                                           FontSize="13" FontWeight="SemiBold" Foreground="#64748B"
                                           Margin="12,10,12,8"/>
                                <ItemsControl ItemsSource="{Binding AvailableDichVus}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="12,8" Cursor="Hand" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TenDichVu}" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"/>
                                                        <TextBlock Text="{Binding DonGia, StringFormat='{}{0:#,0}₫'}" FontSize="11" Foreground="#64748B"/>
                                                    </StackPanel>
                                                    <Button DockPanel.Dock="Right" Content="+" FontSize="18" FontWeight="Bold"
                                                            Width="32" Height="32" Cursor="Hand"
                                                            Command="{Binding DataContext.AddDichVuToListCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="bg" Background="#E8F5E9" CornerRadius="8">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="bg" Property="Background" Value="#4CAF50"/>
                                                                        <Setter Property="Foreground" Value="White"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </Border>

                        <!-- Cột phải: Dịch vụ đã chọn -->
                        <Border Grid.Column="2" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Đã chọn"
                                           FontSize="13" FontWeight="SemiBold" Foreground="#64748B"
                                           Margin="12,10,12,8"/>

                                <ItemsControl ItemsSource="{Binding SelectedDichVus}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="12,8" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DichVu.TenDichVu}" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"/>
                                                        <TextBlock Text="{Binding ThanhTien, StringFormat='{}{0:#,0}₫'}" FontSize="11" Foreground="#3B82F6"/>
                                                    </StackPanel>

                                                    <!-- Nút -/+ số lượng -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                                        <Button Content="−" Width="24" Height="24" FontSize="14" Cursor="Hand"
                                                                Command="{Binding DataContext.GiamSoLuongCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="bg" Background="#FEE2E2" CornerRadius="6">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="bg" Property="Background" Value="#E53935"/>
                                                                            <Setter Property="Foreground" Value="White"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>

                                                        <TextBlock Text="{Binding SoLuong}" FontSize="13" FontWeight="Bold"
                                                                   VerticalAlignment="Center" Margin="8,0"
                                                                   MinWidth="16" TextAlignment="Center"/>

                                                        <Button Content="+" Width="24" Height="24" FontSize="14" Cursor="Hand"
                                                                Command="{Binding DataContext.TangSoLuongCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="bg" Background="#E8F5E9" CornerRadius="6">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="bg" Property="Background" Value="#4CAF50"/>
                                                                            <Setter Property="Foreground" Value="White"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </StackPanel>

                                                    <!-- Nút xóa -->
                                                    <Button Grid.Column="2" Content="✕" FontSize="12" Foreground="#E53935" Cursor="Hand"
                                                            Command="{Binding DataContext.RemoveDichVuFromListCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent" BorderThickness="0"
                                                            VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- Footer -->
                    <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="0,0,16,16" Padding="25,15">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock Text="Tổng cộng:" FontSize="13" Foreground="#64748B"/>
                                <TextBlock Text="{Binding TongTienDichVu, StringFormat='{}{0:#,0}₫'}"
                                           FontSize="20" FontWeight="Bold" Foreground="#E53935"/>
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Margin="0,0,10,0" Height="40" Cursor="Hand"
                                        Command="{Binding CloseServicePopupCommand}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bg" Background="#F1F5F9" CornerRadius="10" Padding="20,0">
                                                <TextBlock Text="Hủy bỏ" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="#E2E8F0"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Height="40" Cursor="Hand"
                                        Command="{Binding SubmitDichVuCommand}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bg" Background="#4CAF50" CornerRadius="10" Padding="20,0">
                                                <TextBlock Text="Gửi yêu cầu" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bg" Property="Opacity" Value="0.85"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <!-- ══════════════════════════════════════════════ -->
        <!-- POPUP: HÓA ĐƠN (sau checkout)                -->
        <!-- ══════════════════════════════════════════════ -->
        <Grid Visibility="{Binding IsHoaDonOpen, Converter={StaticResource BoolToVis}}"
              Background="#80000000">
            <Grid.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding CloseHoaDonCommand}"/>
            </Grid.InputBindings>

            <Border Background="White" CornerRadius="16" Padding="0"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Width="460">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.3"/>
                </Border.Effect>

                <StackPanel>
                    <!-- Header -->
                    <Border Padding="25,22,25,18">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="44" Height="44" Background="#1A73E8" CornerRadius="10">
                                <TextBlock Text="🏨" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Button DockPanel.Dock="Right" Content="✕" FontSize="16"
                                    Width="28" Height="28" VerticalAlignment="Center" Cursor="Hand"
                                    Command="{Binding CloseHoaDonCommand}"
                                    Background="Transparent" BorderThickness="0" Foreground="#94A3B8"/>
                            <TextBlock Text="Hóa Đơn" FontSize="22" FontWeight="Bold" Foreground="#1E293B"
                                       VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </DockPanel>
                    </Border>

                    <!-- Tên khách + phòng -->
                    <StackPanel Margin="25,0,25,0">
                        <TextBlock Text="{Binding HoaDonTenKhach}" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Phòng " FontSize="12" Foreground="#64748B"/>
                            <TextBlock Text="{Binding HoaDonSoPhong}" FontSize="12" FontWeight="SemiBold" Foreground="#1A73E8"/>
                            <TextBlock Text="  •  " FontSize="12" Foreground="#CBD5E1"/>
                            <TextBlock Text="{Binding HoaDonThoiGian}" FontSize="12" Foreground="#64748B"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Background="#E2E8F0" Height="1" Margin="25,18,25,15"/>

                    <!-- Chi tiết tiền -->
                    <Grid Margin="25,0,25,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🛏️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Tiền phòng" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding HoaDonTienPhong, StringFormat='{}{0:#,0} VND'}"
                                   FontSize="14" FontWeight="SemiBold" Foreground="#1E293B"/>
                    </Grid>
                    <Grid Margin="25,0,25,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="☕" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Tiền dịch vụ" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding HoaDonTienDichVu, StringFormat='{}{0:#,0} VND'}"
                                   FontSize="14" FontWeight="SemiBold" Foreground="#1E293B"/>
                    </Grid>

                    <!-- Tổng cộng -->
                    <Border Background="#ECFDF5" CornerRadius="12" Margin="25,5,25,0" Padding="20,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="TỔNG CỘNG" FontSize="11" FontWeight="Bold" Foreground="#059669" Opacity="0.8"/>
                                <TextBlock Text="Cần thanh toán" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding HoaDonTongTien, StringFormat='{}{0:#,0} VND'}"
                                       FontSize="22" FontWeight="Bold" Foreground="#059669"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="Cảm ơn quý khách!" FontSize="12" Foreground="#94A3B8"
                               HorizontalAlignment="Center" Margin="0,18,0,0" FontStyle="Italic"/>

                    <Border Padding="25,18,25,22">
                        <Button Height="44" Cursor="Hand" Command="{Binding CloseHoaDonCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="#1A73E8" CornerRadius="10">
                                        <TextBlock Text="Đóng" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
