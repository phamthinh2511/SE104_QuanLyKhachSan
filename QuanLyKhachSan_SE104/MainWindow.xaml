<Window x:Class="QuanLyKhachSan_SE104.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuanLyKhachSan_SE104"
        mc:Ignorable="d"
        Title="Hotel Management" Height="800" Width="1200"
        
        WindowState="Maximized" 
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>

        <!-- Converter: bool → Visibility -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ══ Style từng nav item ══ -->
        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"     Value="0"/>
            <Setter Property="Margin"      Value="0"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Height="44">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <!-- Indicator bar -->
                                <ColumnDefinition Width="*"/>
                                <!-- Nội dung -->
                            </Grid.ColumnDefinitions>

                            <!-- Nền hover / selected -->
                            <Border x:Name="BgLayer"
                                    Grid.ColumnSpan="2"
                                    Background="Transparent"/>

                            <!-- Thanh xanh bên trái khi selected -->
                            <Border x:Name="Indicator"
                                    Grid.Column="0"
                                    Background="#1A73E8"
                                    CornerRadius="0,3,3,0"
                                    Visibility="Collapsed"/>

                            <!-- Row: Icon | Label | Badge -->
                            <Grid Grid.Column="1" Margin="10,0,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <!-- Icon -->
                                    <ColumnDefinition Width="*"/>
                                    <!-- Text -->
                                    <ColumnDefinition Width="Auto"/>
                                    <!-- Badge -->
                                </Grid.ColumnDefinitions>

                                <!-- Icon -->
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Icon}"
                                           FontSize="17"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>

                                <!-- Label -->
                                <TextBlock x:Name="Label"
                                           Grid.Column="1"
                                           Text="{Binding Title}"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"
                                           Foreground="#555555"/>

                                <!-- ══ BADGE ══ -->
                                <!-- Visibility binding vào HasBadge -->
                                <Border Grid.Column="2"
                                        Visibility="{Binding HasBadge,
                                            Converter={StaticResource BoolToVis}}"
                                        Background="#E53935"
                                        CornerRadius="10"
                                        MinWidth="20" Height="20"
                                        Padding="5,0"
                                        VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{Binding BadgeCount}"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- Triggers thay đổi style theo state -->
                        <ControlTemplate.Triggers>

                            <!-- Hover -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BgLayer"
                                        Property="Background" Value="#F0F4FF"/>
                                <Setter TargetName="Label"
                                        Property="Foreground" Value="#1A73E8"/>
                            </Trigger>

                            <!-- Selected -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="BgLayer"
                                        Property="Background" Value="#E8F0FE"/>
                                <Setter TargetName="Indicator"
                                        Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Label"
                                        Property="Foreground" Value="#1A73E8"/>
                                <Setter TargetName="Label"
                                        Property="FontWeight" Value="SemiBold"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ Style ListBox bỏ border mặc định ══ -->
        <Style x:Key="NavListBoxStyle" TargetType="ListBox">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility"
                    Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility"
                    Value="Auto"/>
        </Style>

    </Window.Resources>

    <!-- ══ LAYOUT CHÍNH ══ -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <!-- Sidebar -->
            <ColumnDefinition Width="*"/>
            <!-- Content -->
        </Grid.ColumnDefinitions>

        <!-- ════════════ SIDEBAR ════════════ -->
        <Border Grid.Column="0"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <!-- App header -->
                    <RowDefinition Height="*"/>
                    <!-- Nav list -->
                </Grid.RowDefinitions>

                <!-- App header -->
                <Border Grid.Row="0"
                        BorderBrush="#E0E0E0"
                        BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="16,0">
                        <Border Width="36" Height="36"
                                Background="#1A73E8"
                                CornerRadius="8">
                            <TextBlock Text="🏨" FontSize="20"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Hotel Manager"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="#1A1A2E"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Danh sách điều hướng -->
                <ListBox Grid.Row="1"
                         Margin="0,8,0,0"
                         ItemsSource="{Binding Pages}"
                         SelectedItem="{Binding CurrentPage}"
                         Style="{StaticResource NavListBoxStyle}"
                         ItemContainerStyle="{StaticResource NavItemStyle}"/>
            </Grid>
        </Border>

        <!-- ════════════ CONTENT ════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <!-- Topbar -->
                <RowDefinition Height="*"/>
                <!-- Page content -->
            </Grid.RowDefinitions>

            <!-- Topbar -->
            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="0,0,0,1">
                <Grid Margin="20,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentTitle}"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="#1A1A2E"/>
                        <TextBlock Text="Chào mừng, Manager"
                                   FontSize="12" Foreground="#888"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Nội dung trang -->
            <ContentPresenter Grid.Row="1"
                              Margin="20"
                              Content="{Binding CurrentContent}"/>
        </Grid>
    </Grid>
</Window>
