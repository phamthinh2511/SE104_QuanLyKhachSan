<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:model="clr-namespace:QuanLyKhachSan_SE104.Model"
                    xmlns:Utilities="clr-namespace:QuanLyKhachSan_SE104.Utilities">

    <!-- ==================== COLORS ==================== -->
    <Color x:Key="PrimaryColor">#1E293B</Color>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>

    <Color x:Key="SecondaryColor">#64748B</Color>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>

    <Color x:Key="AccentColor">#3B82F6</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>

    <Color x:Key="BackgroundLightColor">#F8FAFC</Color>
    <SolidColorBrush x:Key="BackgroundLightBrush" Color="{StaticResource BackgroundLightColor}"/>

    <FontFamily x:Key="MainFont">Segoe UI, Roboto, Helvetica, Arial</FontFamily>

    <!-- ==================== TEXTBOX ==================== -->
    <Style x:Key="ModernTextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#E2E8F0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border" 
                            CornerRadius="8" 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="0,0,15,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="border" 
                            CornerRadius="10" 
                            Background="White" 
                            BorderBrush="#E2E8F0" 
                            BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="🔍" 
                                       FontSize="16"
                                       VerticalAlignment="Center" 
                                       HorizontalAlignment="Center" 
                                       Foreground="#94A3B8"
                                       Grid.Column="0"/>

                                <Grid Grid.Column="1">
                                    <TextBlock x:Name="placeholder" 
                                           Text="{TemplateBinding Tag}" 
                                           Foreground="#94A3B8" 
                                           VerticalAlignment="Center" 
                                           Margin="5,0"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed"
                                           FontStyle="Italic"/>

                                    <ScrollViewer x:Name="PART_ContentHost" 
                                              VerticalAlignment="Center" 
                                              Margin="5,0"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="placeholder" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#334155"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="0.8"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Foreground" Value="#1E293B"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="gd" Background="Transparent" CornerRadius="6" Margin="4,2">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0,0,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="gd" Property="Background" Value="#F1F5F9"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="gd" Property="Background" Value="{StaticResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernComboBox" TargetType="ComboBox">
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#E2E8F0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid x:Name="MainGrid" SnapsToDevicePixels="True">
                        <ToggleButton x:Name="ToggleButton" 
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="border" 
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="8"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Grid Margin="{TemplateBinding Padding}" IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ContentPresenter Grid.Column="0" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                            <TextBlock Grid.Column="1" 
                                       Text="▾" 
                                       Foreground="#94A3B8" 
                                       VerticalAlignment="Center" 
                                       Margin="8,0,0,0"
                                       FontSize="14"/>
                        </Grid>

                        <Popup x:Name="PART_Popup" 
                               AllowsTransparency="true" 
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" 
                               Placement="Bottom" 
                               PopupAnimation="Slide">
                            <Border x:Name="dropDownBorder" 
                                    Background="White" 
                                    BorderBrush="#E2E8F0" 
                                    BorderThickness="1" 
                                    CornerRadius="8" 
                                    Margin="0,4,0,0" 
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="StatsFilterButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="40"/>
        <Setter Property="Margin" Value="3,0"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" 
                        Background="{TemplateBinding Background}"
                        CornerRadius="6"
                        SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.1"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" 
                                      VerticalAlignment="Center"
                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Thay thế DataTemplate x:Key="RoomCardTemplate" trong ResourceDictionary -->

    <DataTemplate x:Key="RoomCardTemplate" DataType="{x:Type model:Phong}">
        <Border x:Name="RoomCard" Width="200" Height="160" Margin="0,0,15,15"
        CornerRadius="12" Background="White" BorderThickness="1" BorderBrush="#E2E8F0"
        Cursor="Hand">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick"
                  Command="{Binding DataContext.MoChiTietPhongCommand,
                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                  CommandParameter="{Binding}"/>
            </Border.InputBindings>

            <Grid>
                <Border x:Name="StatusSideBar" Width="6" HorizontalAlignment="Left" CornerRadius="12,0,0,12"/>
                <Button Panel.ZIndex="10"
        HorizontalAlignment="Right" 
        VerticalAlignment="Top"
        Margin="0,8,8,0"
        Width="30" Height="30"
        Cursor="Hand"
        ToolTip="Xem cảnh báo hôm nay"
        Command="{Binding DataContext.ShowWarningCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
        CommandParameter="{Binding}"
        Background="Transparent" 
        BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Opacity" Value="0.8"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCheckInToday}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCheckOutToday}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>

                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                    <Setter Property="Background" Value="#FEE2E2"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="⚠️" FontSize="16" Foreground="#E11D48" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
                <Grid Margin="18,15,15,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="False">
                        <TextBlock Text="{Binding TenPhong}" FontSize="22" FontWeight="Bold" 
                           Foreground="#1E293B" DockPanel.Dock="Left"/>
                        <TextBlock Text="🛏️" FontSize="18" Foreground="#94A3B8" 
                           DockPanel.Dock="Right" VerticalAlignment="Center"/>
                    </DockPanel>

                    <TextBlock Grid.Row="1" Text="{Binding LoaiPhong.TenLoaiPhong}" 
                       Foreground="#64748B" FontSize="11" Margin="0,2,0,0"/>

                    <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="GuestName" Text="Trống" FontSize="13" 
                               Foreground="#94A3B8" FontStyle="Italic" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="GuestSeparator" Text=" - " FontSize="13" 
                               Foreground="#94A3B8" FontStyle="Italic" Visibility="Collapsed"/>
                            <TextBlock x:Name="CheckoutTime" Text="" FontSize="13" 
                               Foreground="#94A3B8" FontStyle="Italic"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding LoaiPhong.GiaMacDinh, StringFormat='{}{0:#,0}₫'}" 
                               FontSize="13" FontWeight="SemiBold" Foreground="#3B82F6"/>
                            <TextBlock Text="/đêm" FontSize="10" Foreground="#94A3B8" 
                               VerticalAlignment="Bottom" Margin="2,0,0,1"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="StatusIcon" Text="●" FontSize="10" 
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="StatusText" Text="Sẵn sàng" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding TrangThai}" Value="0">
                <Setter TargetName="RoomCard"      Property="Background"  Value="#F1F8E9"/>
                <Setter TargetName="StatusSideBar" Property="Background"  Value="#4CAF50"/>
                <Setter TargetName="StatusText"    Property="Text"        Value="TRỐNG"/>
                <Setter TargetName="StatusText"    Property="Foreground"  Value="#2E7D32"/>
                <Setter TargetName="StatusIcon"    Property="Foreground"  Value="#4CAF50"/>
            </DataTrigger>
            
            <DataTrigger Binding="{Binding TrangThaiDonDep}" Value="1">
                <Setter TargetName="RoomCard"      Property="Background"  Value="#E3F2FD"/>
                <Setter TargetName="StatusSideBar" Property="Background"  Value="#42A5F5"/>
                <Setter TargetName="StatusText"    Property="Text"        Value="ĐANG DỌN"/>
                <Setter TargetName="StatusText"    Property="Foreground"  Value="#1565C0"/>
                <Setter TargetName="StatusIcon"    Property="Foreground"  Value="#42A5F5"/>
                <Setter TargetName="GuestName"     Property="Text"        Value="Chưa sẵn sàng phục vụ"/>
                <Setter TargetName="GuestName"     Property="Foreground"  Value="#64748B"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding TrangThai}" Value="1">
                <Setter TargetName="RoomCard"      Property="Background"  Value="#FFFDE7"/>
                <Setter TargetName="StatusSideBar" Property="Background"  Value="#FBC02D"/>
                <Setter TargetName="StatusText"    Property="Text"        Value="ĐÃ ĐẶT"/>
                <Setter TargetName="StatusText"    Property="Foreground"  Value="#827717"/>
                <Setter TargetName="StatusIcon"    Property="Foreground"  Value="#FBC02D"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding TrangThai}" Value="2">
                <Setter TargetName="RoomCard"      Property="Background"  Value="#FFF3E0"/>
                <Setter TargetName="StatusSideBar" Property="Background"  Value="#FF7043"/>
                <Setter TargetName="StatusText"    Property="Text"        Value="ĐANG Ở"/>
                <Setter TargetName="StatusText"    Property="Foreground"  Value="#E64A19"/>
                <Setter TargetName="StatusIcon"    Property="Foreground"  Value="#FF7043"/>
                <Setter TargetName="GuestName"     Property="Text"        Value="Khách đang ở"/>
                <Setter TargetName="GuestSeparator" Property="Visibility" Value="Visible"/>
                <Setter TargetName="GuestName"     Property="Foreground"  Value="#1E293B"/>
                <Setter TargetName="GuestName"     Property="FontStyle"   Value="Normal"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding TrangThai}" Value="3">
                <Setter TargetName="RoomCard"      Property="Background"  Value="#FFF0F0"/>
                <Setter TargetName="StatusSideBar" Property="Background"  Value="#F44336"/>
                <Setter TargetName="StatusText"    Property="Text"        Value="QUÁ HẠN"/>
                <Setter TargetName="StatusText"    Property="Foreground"  Value="#C62828"/>
                <Setter TargetName="StatusIcon"    Property="Foreground"  Value="#F44336"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding TrangThai}" Value="4">
                <Setter TargetName="RoomCard"      Property="Background"  Value="#E3F2FD"/>
                <Setter TargetName="StatusSideBar" Property="Background"  Value="#42A5F5"/>
                <Setter TargetName="StatusText"    Property="Text"        Value="CẦN DỌN"/>
                <Setter TargetName="StatusText"    Property="Foreground"  Value="#1565C0"/>
                <Setter TargetName="StatusIcon"    Property="Foreground"  Value="#42A5F5"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding TrangThai}" Value="5">
                <Setter TargetName="RoomCard"      Property="Background"  Value="#ECEFF1"/>
                <Setter TargetName="StatusSideBar" Property="Background"  Value="#90A4AE"/>
                <Setter TargetName="StatusText"    Property="Text"        Value="BẢO TRÌ"/>
                <Setter TargetName="StatusText"    Property="Foreground"  Value="#546E7A"/>
                <Setter TargetName="StatusIcon"    Property="Foreground"  Value="#90A4AE"/>
            </DataTrigger>

            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="RoomCard" Property="BorderBrush"     Value="#42A5F5"/>
                <Setter TargetName="RoomCard" Property="BorderThickness"  Value="1.5"/>
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate x:Key="AvailableRoomCardTemplate" DataType="{x:Type model:Phong}">
        <Border x:Name="Card"
            Width="220" Height="130"
            Margin="0,0,12,12"
            CornerRadius="12"
            Background="White"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            Cursor="Hand">

            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding TenPhong}"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#1E293B"/>

                <TextBlock Grid.Row="1"
                       Text="{Binding LoaiPhong.TenLoaiPhong}"
                       FontSize="12"
                       Foreground="#64748B"
                       Margin="0,2,0,0"/>

                <TextBlock Grid.Row="2"
                       Text="{Binding Tang.SoTang, StringFormat='Tầng {0}'}"
                       FontSize="12"
                       Foreground="#94A3B8"
                       VerticalAlignment="Center"/>

                <Grid Grid.Row="3" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding LoaiPhong.GiaMacDinh, StringFormat=''}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#3B82F6"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="●" Foreground="#4CAF50" Margin="0,0,5,0"/>
                        <TextBlock Text="Trống"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#2E7D32"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <DataTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Card" Property="BorderBrush" Value="#3B82F6"/>
                <Setter TargetName="Card" Property="BorderThickness" Value="1.5"/>
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>
    <Style x:Key="SelectableRoomItemStyle" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="DatePicker">
        <Setter Property="Height" Value="40"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#E2E8F0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Grid x:Name="InternalGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="BaseBorder" Grid.ColumnSpan="2" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8"/>

                        <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0" 
                                         Focusable="False" 
                                         HorizontalContentAlignment="Stretch" 
                                         VerticalContentAlignment="Center" 
                                         Padding="12,0"
                                         BorderThickness="0" 
                                         Background="Transparent"/>

                        <Button x:Name="PART_Button" Grid.Column="1" 
                                Margin="0,0,5,0" VerticalAlignment="Center"
                                Focusable="False" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Background="Transparent">
                                        <TextBlock Text="📅" Foreground="#94A3B8" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Grid>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" StaysOpen="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BaseBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DatePickerTextBox">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePickerTextBox">
                    <ContentControl x:Name="PART_Root" Grid.Column="0" 
                                    Focusable="{TemplateBinding Focusable}" 
                                    Content="{TemplateBinding Text}" 
                                    VerticalAlignment="Center"
                                    Margin="12,0"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="10"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="5">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="#F1F5F9"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="#DBEAFE"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PopupOverlayStyle" TargetType="Border">
        <Setter Property="Background" Value="#0F172A"/>
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="CornerRadius" Value="25"/>
    </Style>

    <Style x:Key="PopupContentBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Padding" Value="30"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.2"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== DATAGRID ==================== -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="GridLinesVisibility" Value="None"/>
        <Setter Property="RowHeight" Value="48"/>
        <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/>
        <Setter Property="RowDetailsVisibilityMode" Value="Collapsed"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Margin" Value="0,1"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#EFF6FF"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#DBEAFE"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="#1E293B"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="Transparent" Padding="12,0">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="#1E293B"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="#64748B"/>
        <Setter Property="Background" Value="#F8FAFC"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="#E2E8F0"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Nút Xóa trong DataGrid -->
    <Style x:Key="DeleteButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#FEE2E2"/>
        <Setter Property="Foreground" Value="#DC2626"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Width" Value="60"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#DC2626"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Nút Sửa trong DataGrid -->
    <Style x:Key="EditButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#EFF6FF"/>
        <Setter Property="Foreground" Value="#2563EB"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Width" Value="60"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#2563EB"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>