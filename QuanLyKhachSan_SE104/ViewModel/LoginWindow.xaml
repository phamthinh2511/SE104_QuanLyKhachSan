<Window x:Class="QuanLyKhachSan_SE104.View.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng Nhập Hệ Thống" Height="400" Width="350"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F3F4F6">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="ĐĂNG NHẬP" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Tên đăng nhập:" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Username}" Height="30" Margin="0,0,0,15" Padding="5"/>

            <TextBlock Text="Mật khẩu:" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtPassword" Height="30" Margin="0,0,0,10" Padding="5"/>

            <!-- Nút Quên mật khẩu dạng Text Click -->
            <TextBlock HorizontalAlignment="Right" Margin="0,0,0,20">
                <Hyperlink Command="{Binding OpenForgotPasswordCommand}">
                    Quên mật khẩu?
                </Hyperlink>
            </TextBlock>

            <Button Content="Đăng Nhập" Command="{Binding LoginCommand}" CommandParameter="{Binding ElementName=txtPassword}"
                    Height="40" Background="#1A73E8" Foreground="White" FontWeight="Bold" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>