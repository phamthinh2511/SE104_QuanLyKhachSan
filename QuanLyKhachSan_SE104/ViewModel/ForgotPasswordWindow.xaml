<Window x:Class="QuanLyKhachSan_SE104.View.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quên Mật Khẩu" Height="250" Width="300"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F3F4F6">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Cấp Lại Mật Khẩu" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>
            <TextBlock Text="Nhập Username của bạn:" Margin="0,0,0,5"/>
            <TextBox Name="txtUsernameForgot" Height="30" Margin="0,0,0,15" Padding="5"/>
            <Button Content="Gửi yêu cầu" Click="BtnSubmit_Click"
                    Height="35" Background="#1A73E8" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>